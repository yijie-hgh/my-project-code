/* pages/equipment/detail/detail.wxss */

/* 顶部信息 */
.info-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.info-top {
  margin-bottom: 16rpx;
}
.info-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.info-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
  margin-right: 16rpx;
}
.info-code {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}
.info-tags {
  display: flex;
  gap: 16rpx;
}
.header-tag {
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 编辑按钮 */
.edit-btn {
  margin-left: auto;
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}
.edit-btn:active {
  opacity: 0.7;
}

/* 卡片 */
.card {
  margin: 20rpx 24rpx;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 50%;
  padding: 12rpx 0;
}
.grid-label {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}
.grid-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: #6b7280;
  width: 160rpx;
  flex-shrink: 0;
}
.row-value {
  font-size: 28rpx;
  color: #1f2937;
  flex: 1;
}
.row-value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.call-btn {
  font-size: 24rpx;
  color: #2563eb;
  background: #dbeafe;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.call-btn:active {
  opacity: 0.7;
}

/* 校验过期提醒 */
.calib-warn {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #fef2f2;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ef4444;
  line-height: 1.5;
}

/* 标识信息 */
.id-tags {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.id-tag-item {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
}
.id-tag-item:active {
  background: #f3f4f6;
}
.id-tag-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.id-tag-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.id-tag-label {
  font-size: 24rpx;
  color: #9ca3af;
}
.id-tag-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  margin-top: 4rpx;
}
.id-tag-action {
  font-size: 24rpx;
  color: #2563eb;
  padding: 8rpx 20rpx;
  border: 2rpx solid #2563eb;
  border-radius: 20rpx;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}
.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  margin: 0 8rpx;
}
.action-btn:active {
  opacity: 0.85;
}
.action-icon {
  font-size: 36rpx;
}
.action-text {
  font-size: 24rpx;
  color: #fff;
  margin-top: 4rpx;
}
.spotcheck-btn {
  background: linear-gradient(135deg, #10b981, #34d399);
}
.repair-btn {
  background: linear-gradient(135deg, #ef4444, #f87171);
}
.maintain-btn {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}
.page-bg {
  padding-bottom: 160rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b7280;
  z-index: 999;
}

/* ============ 设备健康分 ============ */
.health-section {
  display: flex;
  align-items: center;
  gap: 30rpx;
}
.health-ring {
  flex-shrink: 0;
}
.health-ring-outer {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.health-ring-inner {
  width: 134rpx;
  height: 134rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.health-score {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}
.health-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}
.health-info {
  flex: 1;
}
.health-level {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.health-suggestions {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* ============ 维护时间线 ============ */
.timeline {
  padding: 8rpx 0;
}
.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}
.timeline-item:last-child {
  padding-bottom: 0;
}
.timeline-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}
.timeline-icon {
  font-size: 28rpx;
}
.timeline-line {
  position: absolute;
  left: 27rpx;
  top: 56rpx;
  bottom: 0;
  width: 2rpx;
  background: #e5e7eb;
}
.timeline-line.last {
  display: none;
}
.timeline-content {
  flex: 1;
  margin-left: 20rpx;
  padding-top: 4rpx;
}
.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.timeline-action {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.timeline-time {
  font-size: 22rpx;
}
.timeline-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.4;
}

/* ============ 关联记录 ============ */
.link-grid {
  display: flex;
  gap: 16rpx;
}
.link-item {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
}
.link-item:active {
  background: #f3f4f6;
}
.link-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}
.link-text {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}
.link-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}
