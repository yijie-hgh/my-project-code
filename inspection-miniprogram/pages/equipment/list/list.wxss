/* pages/equipment/list/list.wxss */

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-clear {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 10rpx;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  padding: 0 24rpx 16rpx;
}
.status-tabs {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  padding-bottom: 16rpx;
}
.status-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6b7280;
  background: #f3f4f6;
  transition: all 0.2s;
  flex-shrink: 0;
}
.status-tab.active {
  background: #2563eb;
  color: #fff;
}

/* 筛选选择器 */
.filter-pickers {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.filter-picker {
  flex: 1;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 60rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  padding: 0 20rpx;
}
.picker-value.active {
  background: #eff6ff;
  color: #2563eb;
}
.picker-text {
  flex: 1;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-arrow {
  font-size: 18rpx;
}
.reset-btn {
  font-size: 24rpx;
  color: #ef4444;
  padding: 0 16rpx;
  flex-shrink: 0;
}

/* 迷你统计 */
.mini-stats {
  display: flex;
  background: #fff;
  margin: 0 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.mini-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mini-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}
.mini-stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 列表区域 */
.list-wrap {
  padding: 20rpx 24rpx 140rpx;
}

/* 设备卡片 */
.equip-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.equip-card:active {
  background: #fafbfc;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.equip-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.equip-code {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}

/* 卡片信息 */
.card-info {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.info-label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 100rpx;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
}

/* 浮动按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 100;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 44rpx;
  color: #fff;
  line-height: 1;
}

/* ========== 视图工具栏 ========== */
.view-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  transition: all 0.2s;
}
.tool-btn:active {
  background: #e5e7eb;
  transform: scale(0.95);
}
.tool-icon {
  font-size: 30rpx;
  line-height: 1;
}
.search-bar {
  display: flex;
  align-items: center;
}
.search-input-wrap {
  flex: 1;
}

/* ========== 表格视图 ========== */
.table-view-wrap {
  padding: 16rpx 24rpx 140rpx;
}
.table-scroll {
  width: 100%;
  max-height: calc(100vh - 400rpx);
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.table-header {
  display: flex;
  background: #f8fafc;
  border-bottom: 2rpx solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 2;
}
.table-cell {
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #374151;
  flex-shrink: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.table-cell-head {
  font-weight: 600;
  color: #1f2937;
  background: #f8fafc;
}
.table-cell-idx {
  width: 60rpx;
  text-align: center;
  color: #9ca3af;
  flex-shrink: 0;
}
.table-row {
  display: flex;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background 0.2s;
}
.table-row:active {
  background: #f9fafb;
}
.table-cell-action {
  width: 100rpx;
  text-align: center;
  flex-shrink: 0;
}
.row-action-btn {
  color: #2563eb;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #eff6ff;
  border-radius: 8rpx;
}

/* ========== 弹窗通用 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-popup {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  flex-shrink: 0;
}
.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.popup-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.popup-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  padding: 0 32rpx 20rpx;
}
.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 40rpx;
  border-top: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}
.popup-action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s;
}
.popup-action-btn.primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}
.popup-action-btn.primary:active {
  opacity: 0.9;
}
.popup-action-btn.secondary {
  background: #f3f4f6;
  color: #374151;
}
.popup-action-btn.secondary:active {
  background: #e5e7eb;
}

/* ========== 字段配置弹窗 ========== */
.field-config-popup {
  max-height: 80vh;
}
.field-config-scroll {
  flex: 1;
  padding: 0 32rpx;
  max-height: 60vh;
}
.field-group {
  margin-bottom: 32rpx;
}
.field-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #2563eb;
}
.field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.field-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.field-item.selected {
  background: #eff6ff;
  border-color: #2563eb;
}
.field-item.required {
  opacity: 0.9;
}
.field-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}
.field-item.selected .field-checkbox {
  background: #2563eb;
  border-color: #2563eb;
}
.field-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.field-label {
  font-size: 26rpx;
  color: #374151;
}
.field-badge {
  font-size: 20rpx;
  color: #ef4444;
  background: #fef2f2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* ========== 导入弹窗 ========== */
.import-popup {
  max-height: 80vh;
}
.import-content {
  padding: 20rpx 32rpx;
}
.import-tip {
  background: #eff6ff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.import-tip text {
  font-size: 26rpx;
  color: #2563eb;
}
.import-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.import-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.import-btn.primary {
  background: #eff6ff;
  border-color: #2563eb;
  border-style: solid;
}
.import-btn:active {
  transform: scale(0.98);
}
.import-btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.import-btn-text {
  font-size: 26rpx;
  color: #374151;
}
.import-btn.primary .import-btn-text {
  color: #2563eb;
  font-weight: 500;
}

/* 导入结果 */
.import-result {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.result-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.result-status.success {
  background: #dcfce7;
  color: #16a34a;
}
.result-status.fail {
  background: #fee2e2;
  color: #dc2626;
}
.result-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}
.result-errors {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.errors-title {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.error-item {
  font-size: 24rpx;
  color: #ef4444;
  padding: 6rpx 0;
}

/* 标签样式复用 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-success {
  background: #dcfce7;
  color: #16a34a;
}
.tag-danger {
  background: #fee2e2;
  color: #dc2626;
}
.tag-warning {
  background: #fef3c7;
  color: #d97706;
}
.tag-info {
  background: #dbeafe;
  color: #2563eb;
}
.tag-gray {
  background: #f3f4f6;
  color: #6b7280;
}
.tag-primary {
  background: #dbeafe;
  color: #2563eb;
}
