/* pages/equipment/scan/scan.wxss */

.scan-page {
  padding-bottom: 60rpx;
}

/* 扫码区域 */
.scan-area {
  padding: 40rpx 24rpx 20rpx;
}
.scan-bg {
  position: relative;
  height: 360rpx;
  background: linear-gradient(135deg, #1e3a5f, #2563eb);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.scan-frame {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}
.scan-frame.hidden {
  display: none;
}
.frame-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: #fff;
  border-style: solid;
  border-width: 0;
}
.frame-corner.tl {
  top: 0;
  left: 0;
  border-top-width: 6rpx;
  border-left-width: 6rpx;
  border-top-left-radius: 12rpx;
}
.frame-corner.tr {
  top: 0;
  right: 0;
  border-top-width: 6rpx;
  border-right-width: 6rpx;
  border-top-right-radius: 12rpx;
}
.frame-corner.bl {
  bottom: 0;
  left: 0;
  border-bottom-width: 6rpx;
  border-left-width: 6rpx;
  border-bottom-left-radius: 12rpx;
}
.frame-corner.br {
  bottom: 0;
  right: 0;
  border-bottom-width: 6rpx;
  border-right-width: 6rpx;
  border-bottom-right-radius: 12rpx;
}
.scan-beam {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #34d399, transparent);
  top: 50%;
  animation: scanMove 2s linear infinite;
}
@keyframes scanMove {
  0% { top: 10%; }
  50% { top: 90%; }
  100% { top: 10%; }
}
.scan-center-icon {
  position: absolute;
  font-size: 64rpx;
}
.scan-tip {
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  margin: 24rpx 0;
}
.scan-btn {
  margin-top: 8rpx;
}

/* 手动输入 */
.manual-card {
  margin: 0 24rpx 20rpx;
}
.manual-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.manual-input {
  flex: 1;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 76rpx;
  font-size: 28rpx;
  color: #333;
}

/* 识别结果 */
.result-section {
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #10b981;
}
.result-reset {
  font-size: 26rpx;
  color: #2563eb;
  padding: 8rpx 20rpx;
  border: 2rpx solid #2563eb;
  border-radius: 20rpx;
}
.equip-result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 8rpx solid #10b981;
}
.equip-result-card:active {
  background: #fafbfc;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.equip-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.equip-code {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}
.result-info {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.result-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.result-label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 100rpx;
  flex-shrink: 0;
}
.result-value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}
.quick-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.quick-btn:active {
  background: #f9fafb;
}
.quick-icon {
  font-size: 44rpx;
}
.quick-text {
  font-size: 24rpx;
  color: #374151;
  margin-top: 8rpx;
}

/* 未找到 */
.not-found-section {
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}
.not-found-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.not-found-icon {
  font-size: 72rpx;
}
.not-found-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ef4444;
  margin-top: 16rpx;
}
.not-found-desc {
  font-size: 26rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  text-align: center;
}

/* 使用说明 */
.scan-help {
  margin: 0 24rpx;
}
.help-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}
.help-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #dbeafe;
  color: #2563eb;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
