/* pages/repair/create/create.wxss */
.form-card {
  margin: 20rpx 24rpx;
}
.form-item {
  padding: 8rpx 0;
}
.form-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.required {
  color: #ef4444;
  margin-right: 6rpx;
}
.form-label-sub {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 12rpx;
  font-weight: 400;
}

.form-input {
  height: 80rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

/* Picker */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker.placeholder {
  color: #9ca3af;
}
.picker-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.picker-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.picker-arrow {
  font-size: 32rpx;
  color: #9ca3af;
}

/* 紧急程度 */
.level-options {
  display: flex;
  gap: 16rpx;
}
.level-option {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #6b7280;
  transition: all 0.2s;
}
.level-option.active {
  font-weight: 600;
}

/* 描述 */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}
.textarea-count {
  text-align: right;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 照片 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #d1d5db;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}
.photo-add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.photo-add-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
