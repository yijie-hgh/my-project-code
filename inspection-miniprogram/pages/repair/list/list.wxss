/* pages/repair/list/list.wxss */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.feishu-sync-btn {
  padding: 10rpx 20rpx;
  background: #ecfdf5;
  color: #10b981;
  border: 1rpx solid #10b981;
  border-radius: 20rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}

.tab-bar-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab-list {
  display: inline-flex;
  padding: 0 12rpx;
}
.tab-item {
  display: inline-flex;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #2563eb;
  border-radius: 3rpx;
}

.repair-list {
  padding: 20rpx 24rpx;
}
.repair-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.repair-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.card-title-area {
  flex: 1;
  margin-right: 16rpx;
}
.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}
.level-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.repair-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
}
.repair-no {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-left: 26rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.info-item {
  display: flex;
  align-items: center;
}
.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.info-text {
  font-size: 24rpx;
  color: #6b7280;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.card-tags {
  display: flex;
  gap: 12rpx;
}
.repairer-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 卡片快捷操作 */
.card-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 12rpx 0;
}
.action-btn:active {
  opacity: 0.7;
}
.action-btn.danger {
  color: #ef4444;
  background: #fef2f2;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 99;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ========== 视图工具栏 ========== */
.view-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  transition: all 0.2s;
}
.tool-btn:active {
  background: #e5e7eb;
  transform: scale(0.95);
}
.tool-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* ========== 表格视图 ========== */
.table-view-wrap {
  padding: 16rpx 24rpx 140rpx;
}
.table-scroll {
  width: 100%;
  max-height: calc(100vh - 350rpx);
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.table-header {
  display: flex;
  background: #f8fafc;
  border-bottom: 2rpx solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 2;
}
.table-cell {
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #374151;
  flex-shrink: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.table-cell-head {
  font-weight: 600;
  color: #1f2937;
  background: #f8fafc;
}
.table-cell-idx {
  width: 60rpx;
  text-align: center;
  color: #9ca3af;
  flex-shrink: 0;
}
.table-row {
  display: flex;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background 0.2s;
}
.table-row:active {
  background: #f9fafb;
}
.table-cell-action {
  width: 100rpx;
  text-align: center;
  flex-shrink: 0;
}
.row-action-btn {
  color: #2563eb;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #eff6ff;
  border-radius: 8rpx;
}

/* ========== 弹窗通用 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-popup {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
  flex-shrink: 0;
}
.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.popup-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.popup-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  padding: 0 32rpx 20rpx;
}
.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 40rpx;
  border-top: 1rpx solid #f3f4f6;
  flex-shrink: 0;
}
.popup-action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.popup-action-btn.primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}
.popup-action-btn.secondary {
  background: #f3f4f6;
  color: #374151;
}

/* ========== 字段配置弹窗 ========== */
.field-config-scroll {
  flex: 1;
  padding: 0 32rpx;
  max-height: 60vh;
}
.field-group {
  margin-bottom: 32rpx;
}
.field-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #2563eb;
}
.field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.field-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}
.field-item.selected {
  background: #eff6ff;
  border-color: #2563eb;
}
.field-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}
.field-item.selected .field-checkbox {
  background: #2563eb;
  border-color: #2563eb;
}
.field-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.field-label {
  font-size: 26rpx;
  color: #374151;
}
.field-badge {
  font-size: 20rpx;
  color: #ef4444;
  background: #fef2f2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* ========== 导入弹窗 ========== */
.import-content {
  padding: 20rpx 32rpx;
}
.import-tip {
  background: #eff6ff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.import-tip text {
  font-size: 26rpx;
  color: #2563eb;
}
.import-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.import-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
}
.import-btn.primary {
  background: #eff6ff;
  border-color: #2563eb;
  border-style: solid;
}
.import-btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.import-btn-text {
  font-size: 26rpx;
  color: #374151;
}
.import-btn.primary .import-btn-text {
  color: #2563eb;
  font-weight: 500;
}
.import-result {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.result-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.result-status.success {
  background: #dcfce7;
  color: #16a34a;
}
.result-status.fail {
  background: #fee2e2;
  color: #dc2626;
}
.result-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}
.result-errors {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.errors-title {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.error-item {
  font-size: 24rpx;
  color: #ef4444;
  padding: 6rpx 0;
}

/* 通用样式辅助 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}
.text-primary { color: #2563eb; }
.text-success { color: #16a34a; }
.text-danger { color: #dc2626; }
.text-warning { color: #d97706; }
.text-gray { color: #9ca3af; }
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
