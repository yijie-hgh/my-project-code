/* pages/repair/stats/stats.wxss - 维修统计看板样式 */
.stats-page {
  padding-bottom: 40rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 顶部统计卡片 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.stat-red {
  background: linear-gradient(135deg, #ef4444, #f87171);
}
.stat-green {
  background: linear-gradient(135deg, #10b981, #34d399);
}
.stat-blue {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
}
.stat-orange {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}
.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}
.stat-name {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

/* KPI网格（响应时间指标） */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.kpi-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.kpi-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.kpi-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.kpi-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1;
}
.kpi-unit {
  font-size: 22rpx;
  color: #9ca3af;
}
.kpi-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* 饼图区域 */
.pie-section {
  display: flex;
  align-items: center;
  gap: 30rpx;
}
.pie-wrap {
  flex-shrink: 0;
}
.pie-chart {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.pie-inner {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.pie-total-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1;
}
.pie-total-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}
.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.legend-item {
  display: flex;
  align-items: center;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.legend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.legend-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}
.legend-data {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 2rpx;
}
.legend-count {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}
.legend-percent {
  font-size: 22rpx;
}

/* 横向柱状图 */
.bar-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.bar-item {
  width: 100%;
}
.bar-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.bar-rank-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.bar-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rank-1 { background: linear-gradient(135deg, #ef4444, #f87171); }
.rank-2 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.rank-3 { background: linear-gradient(135deg, #6366f1, #818cf8); }
.rank-4 { background: linear-gradient(135deg, #6b7280, #9ca3af); }
.rank-5 { background: linear-gradient(135deg, #6b7280, #9ca3af); }
.bar-name {
  font-size: 26rpx;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bar-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  flex-shrink: 0;
}
.chart-bar {
  height: 24rpx;
  border-radius: 12rpx;
}
.chart-bar .progress-bar-fill {
  transition: width 0.5s ease;
  border-radius: 12rpx;
}

/* 响应时间分布 */
.response-dist-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.response-dist-item {
  width: 100%;
}
.response-dist-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.response-dist-range {
  font-size: 26rpx;
  color: #374151;
}
.response-dist-count {
  font-size: 24rpx;
  color: #6b7280;
}

/* 趋势汇总 */
.trend-summary {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}
.trend-summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.trend-summary-label {
  font-size: 22rpx;
  color: #9ca3af;
}
.trend-summary-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-top: 4rpx;
}
.trend-summary-divider {
  width: 1rpx;
  height: 50rpx;
  background: #e5e7eb;
}

/* 趋势图 */
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.trend-legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6b7280;
}
.trend-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 340rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid #e5e7eb;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 240rpx;
  width: 100%;
  justify-content: center;
}
.trend-bar {
  width: 40rpx;
  min-height: 4rpx;
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.5s ease;
}
.trend-bar-repair {
  background: linear-gradient(180deg, #f87171, #ef4444);
}
.trend-date {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}
.trend-num {
  margin-top: 4rpx;
  color: #6b7280;
}
.trend-cost {
  color: #ef4444;
  font-weight: 500;
  margin-top: 2rpx;
}

/* 刷新按钮 */
.refresh-footer {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #2563eb;
}
