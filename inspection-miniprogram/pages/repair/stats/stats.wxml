<!--pages/repair/stats/stats.wxml-->
<view class="page-bg container stats-page">
  <!-- 加载中 -->
  <view wx:if="{{loading && !repairDist}}" class="card">
    <view class="loading-tip">正在加载维修统计数据...</view>
  </view>

  <block wx:if="{{repairDist}}">
    <!-- 顶部统计概览 -->
    <view class="stats-row">
      <view class="stat-card stat-red">
        <text class="stat-icon">🔧</text>
        <text class="stat-value">{{repairDist.total}}</text>
        <text class="stat-name">维修总数</text>
      </view>
      <view class="stat-card stat-green">
        <text class="stat-icon">✅</text>
        <text class="stat-value">{{repairDist.completed}}</text>
        <text class="stat-name">已完成</text>
      </view>
      <view class="stat-card stat-blue">
        <text class="stat-icon">⚙️</text>
        <text class="stat-value">{{repairDist.inProgress}}</text>
        <text class="stat-name">进行中</text>
      </view>
      <view class="stat-card stat-orange">
        <text class="stat-icon">⏳</text>
        <text class="stat-value">{{repairDist.pending}}</text>
        <text class="stat-name">待受理</text>
      </view>
    </view>

    <!-- 响应时间指标 -->
    <view class="card">
      <view class="card-title">⚡ 响应时间指标</view>
      <view class="kpi-grid">
        <view class="kpi-item">
          <text class="kpi-icon">⚡</text>
          <view class="kpi-value-row">
            <text class="kpi-value">{{repairDist.avgResponseTime}}</text>
            <text class="kpi-unit">分钟</text>
          </view>
          <text class="kpi-label">平均响应时间</text>
        </view>
        <view class="kpi-item">
          <text class="kpi-icon">🔨</text>
          <view class="kpi-value-row">
            <text class="kpi-value">{{repairDist.avgRepairTime}}</text>
            <text class="kpi-unit">小时</text>
          </view>
          <text class="kpi-label">平均维修时间</text>
        </view>
        <view class="kpi-item">
          <text class="kpi-icon">📊</text>
          <view class="kpi-value-row">
            <text class="kpi-value text-success">{{repairDist.completionRate}}%</text>
          </view>
          <text class="kpi-label">完成率</text>
        </view>
      </view>
    </view>

    <!-- 故障类型分布（饼图） -->
    <view class="card">
      <view class="card-title">🏷️ 故障类型分布</view>
      <view class="pie-section">
        <view class="pie-wrap">
          <view class="pie-chart" style="background: {{faultPieGradient}};">
            <view class="pie-inner">
              <text class="pie-total-num">{{faultPieTotal}}</text>
              <text class="pie-total-label">故障总数</text>
            </view>
          </view>
        </view>
        <view class="pie-legend">
          <view wx:for="{{faultTypePie}}" wx:key="name" class="legend-item">
            <view class="legend-dot" style="background:{{item.color}};"></view>
            <view class="legend-info">
              <text class="legend-name">{{item.name}}</text>
              <view class="legend-data">
                <text class="legend-count">{{item.count}}次</text>
                <text class="legend-percent text-sub">{{item.percent}}%</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 高频故障设备Top5 -->
    <view class="card">
      <view class="card-title">🔝 高频故障设备Top5</view>
      <view class="bar-list">
        <view wx:for="{{repairByEquip}}" wx:key="name" class="bar-item">
          <view class="bar-label-row">
            <view class="bar-rank-name">
              <text class="bar-rank rank-{{item.rank}}">{{item.rank}}</text>
              <text class="bar-name">{{item.name}}</text>
            </view>
            <text class="bar-value">{{item.count}}次</text>
          </view>
          <view class="progress-bar chart-bar">
            <view class="progress-bar-fill" style="width:{{item.percent}}%;background:linear-gradient(90deg,#ef4444,#f87171);"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 响应时间分布 -->
    <view class="card">
      <view class="card-title">⚡ 响应时间分布</view>
      <view class="response-dist-list">
        <view wx:for="{{responseTimeDist}}" wx:key="range" class="response-dist-item">
          <view class="response-dist-header">
            <text class="response-dist-range">{{item.range}}</text>
            <text class="response-dist-count">{{item.count}}次 ({{item.percent}}%)</text>
          </view>
          <view class="progress-bar">
            <view class="progress-bar-fill" style="width:{{item.percent}}%;background:linear-gradient(90deg,#2563eb,#3b82f6);"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 月度维修趋势 -->
    <view class="card">
      <view class="card-title">📈 月度维修趋势</view>
      <view class="trend-summary">
        <view class="trend-summary-item">
          <text class="trend-summary-label">累计维修</text>
          <text class="trend-summary-value">{{repairDist.total}}次</text>
        </view>
        <view class="trend-summary-divider"></view>
        <view class="trend-summary-item">
          <text class="trend-summary-label">累计费用</text>
          <text class="trend-summary-value text-danger">¥{{repairCostTotal}}</text>
        </view>
      </view>
      <view class="trend-legend">
        <view class="trend-legend-item">
          <view class="trend-legend-dot" style="background:linear-gradient(180deg,#f87171,#ef4444);"></view>
          <text>维修次数</text>
        </view>
      </view>
      <view class="trend-chart">
        <view wx:for="{{repairTrend}}" wx:key="month" class="trend-col">
          <view class="trend-bars">
            <view class="trend-bar trend-bar-repair" style="height:{{item.countH}}%;"></view>
          </view>
          <text class="trend-date">{{item.month}}</text>
          <text class="trend-num text-sm">{{item.count}}次</text>
          <text wx:if="{{item.cost > 0}}" class="trend-cost text-sm">¥{{item.cost}}</text>
        </view>
      </view>
    </view>

    <!-- 底部刷新 -->
    <view class="refresh-footer" bindtap="onRefresh">
      <text>🔄 刷新数据</text>
    </view>
  </block>
</view>
