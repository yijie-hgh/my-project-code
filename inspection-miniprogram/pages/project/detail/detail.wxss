/* pages/project/detail/detail.wxss */

/* 顶部信息 */
.info-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.info-top {
  margin-bottom: 16rpx;
}
.info-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.info-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
  margin-right: 16rpx;
}
.info-code {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}
.info-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  margin-bottom: 16rpx;
}
.info-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #fff;
  margin: -28rpx 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}
.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-block + .stat-block {
  border-left: 1rpx solid #e5e7eb;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}
.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 完成率卡片 */
.rate-card {
  margin: 0 24rpx 20rpx;
}
.big-progress {
  height: 24rpx;
  background: #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}
.big-progress-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s;
}
.rate-text {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
  text-align: right;
}

/* 关联巡检点列表 */
.card {
  margin: 0 24rpx 20rpx;
}
.point-item {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.point-item:active {
  background: #f3f4f6;
}
.point-item:last-child {
  margin-bottom: 0;
}
.point-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.point-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.point-item-info {
  display: flex;
  gap: 30rpx;
}
.point-item-time {
  margin-top: 8rpx;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}
.page-bg {
  padding-bottom: 140rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.modal-body {
  padding-bottom: 20rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 14rpx;
  font-weight: 500;
}
.required {
  color: #ef4444;
  margin-left: 4rpx;
}
.form-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-textarea {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
}
.modal-footer {
  display: flex;
  padding-top: 10rpx;
}
