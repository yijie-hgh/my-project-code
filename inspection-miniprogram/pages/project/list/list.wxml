<!--pages/project/list/list.wxml-->
<view class="page-bg">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" type="text" placeholder="搜索项目名称" value="{{queryParams.projectName}}" bindinput="onSearchInput" confirm-type="search" />
      <text wx:if="{{queryParams.projectName}}" class="search-clear" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 状态筛选 -->
  <view class="status-tabs">
    <view wx:for="{{statusTabs}}" wx:key="value" class="status-tab {{queryParams.status === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onStatusChange">{{item.label}}</view>
  </view>

  <!-- 项目列表 -->
  <view class="list-wrap">
    <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无项目数据" icon="📁"></empty-state>

    <view wx:for="{{list}}" wx:key="id" class="project-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="card-top">
        <view class="project-name text-ellipsis">{{item.projectName}}</view>
        <text class="tag {{item.statusInfo.tag}}">{{item.statusInfo.text}}</text>
      </view>
      <view class="project-code">编码：{{item.projectCode}}</view>
      <view class="project-desc text-ellipsis" wx:if="{{item.description}}">{{item.description}}</view>

      <view class="card-stats">
        <view class="stat-item">
          <text class="stat-num">{{item.pointCount || 0}}</text>
          <text class="stat-label">巡检点</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{item.taskCount || 0}}</text>
          <text class="stat-label">任务数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num text-primary">{{item.completionRate || 0}}%</text>
          <text class="stat-label">完成率</text>
        </view>
      </view>

      <!-- 完成率进度条 -->
      <view class="progress-bar mt-10">
        <view class="progress-bar-fill" style="width: {{item.completionRate || 0}}%; background: {{(item.completionRate || 0) >= 90 ? 'linear-gradient(90deg,#10b981,#34d399)' : (item.completionRate || 0) >= 75 ? 'linear-gradient(90deg,#2563eb,#3b82f6)' : 'linear-gradient(90deg,#f59e0b,#fbbf24)'}};"></view>
      </view>

      <!-- 编辑按钮 -->
      <view class="card-edit" catchtap="onEdit" data-item="{{item}}">
        <text>编辑</text>
      </view>
    </view>
  </view>

  <!-- 浮动新增按钮 -->
  <view class="fab-btn" bindtap="onAdd">
    <text class="fab-icon">+</text>
  </view>

  <!-- 新增/编辑弹窗 -->
  <view wx:if="{{showForm}}" class="modal-mask" bindtap="onCloseForm">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{isEdit ? '编辑项目' : '新增项目'}}</text>
        <text class="modal-close" bindtap="onCloseForm">✕</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">项目名称<text class="required">*</text></text>
          <input class="form-input" placeholder="请输入项目名称" value="{{form.projectName}}" data-field="projectName" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">项目编码<text class="required">*</text></text>
          <input class="form-input" placeholder="请输入项目编码" value="{{form.projectCode}}" data-field="projectCode" bindinput="onFormInput" />
        </view>
        <view class="form-item">
          <text class="form-label">项目描述</text>
          <textarea class="form-textarea" placeholder="请输入项目描述（选填）" value="{{form.description}}" data-field="description" bindinput="onFormInput" maxlength="200"></textarea>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-plain btn-sm" style="flex:1;margin-right:20rpx;" bindtap="onCloseForm">取消</view>
        <view class="btn btn-primary btn-sm" style="flex:1;" bindtap="onSubmitForm">确定</view>
      </view>
    </view>
  </view>
</view>
