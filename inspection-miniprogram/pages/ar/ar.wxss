/* pages/ar/ar.wxss - AR巡检科技感深色UI */
.ar-page {
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 顶部说明卡片 */
.ar-intro {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.intro-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1e3a8a, #6366f1, #8b5cf6);
  opacity: 0.9;
}
.intro-content {
  position: relative;
  display: flex;
  padding: 36rpx;
  align-items: flex-start;
}
.intro-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 0 30rpx rgba(99, 102, 241, 0.6);
}
.intro-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}
.intro-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}

/* 卡片适配深色 */
.ar-card {
  background: rgba(30, 41, 59, 0.9);
  margin: 0 24rpx 24rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}
.ar-card .card-title {
  color: #e2e8f0;
}
.ar-card .card-title::before {
  background: linear-gradient(180deg, #6366f1, #8b5cf6);
}

/* 功能网格 */
.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 0;
}
.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}
.icon-identify { background: rgba(59, 130, 246, 0.2); box-shadow: 0 0 20rpx rgba(59, 130, 246, 0.3); }
.icon-fault { background: rgba(239, 68, 68, 0.2); box-shadow: 0 0 20rpx rgba(239, 68, 68, 0.3); }
.icon-remote { background: rgba(16, 185, 129, 0.2); box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.3); }
.icon-nav { background: rgba(245, 158, 11, 0.2); box-shadow: 0 0 20rpx rgba(245, 158, 11, 0.3); }
.func-item:active .func-icon { transform: scale(0.9); }
.func-name {
  font-size: 24rpx;
  color: #cbd5e1;
}
.pulse .func-icon {
  animation: pulse-glow 1.5s ease-in-out infinite;
}
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(59, 130, 246, 0.3); }
  50% { box-shadow: 0 0 40rpx rgba(59, 130, 246, 0.8); }
}

/* AR扫描遮罩 */
.ar-scan-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scan-container {
  width: 88%;
  background: #1e293b;
  border-radius: 24rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.4);
  overflow: hidden;
  box-shadow: 0 0 60rpx rgba(99, 102, 241, 0.3);
}
.scan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid rgba(99, 102, 241, 0.2);
}
.scan-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e2e8f0;
}
.scan-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}
.scan-viewport {
  position: relative;
  height: 520rpx;
  margin: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #0f172a;
}
.scan-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(99, 102, 241, 0.15) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(99, 102, 241, 0.15) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}
.scan-frame {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 360rpx;
  height: 360rpx;
}
.frame-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: #6366f1;
  border-style: solid;
}
.frame-corner.tl { top: 0; left: 0; border-width: 6rpx 0 0 6rpx; }
.frame-corner.tr { top: 0; right: 0; border-width: 6rpx 6rpx 0 0; }
.frame-corner.bl { bottom: 0; left: 0; border-width: 0 0 6rpx 6rpx; }
.frame-corner.br { bottom: 0; right: 0; border-width: 0 6rpx 6rpx 0; }
.scan-beam {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #6366f1, transparent);
  box-shadow: 0 0 20rpx #6366f1;
}
.beam-anim {
  animation: beam-scan 2s linear infinite;
}
@keyframes beam-scan {
  0% { top: 0; }
  50% { top: 100%; }
  100% { top: 0; }
}
.scan-tip-text {
  position: absolute;
  bottom: 30rpx; left: 0; right: 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}
.scan-info-overlay {
  position: absolute;
  bottom: 80rpx; left: 30rpx; right: 30rpx;
}
.scan-progress-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 6rpx;
  overflow: hidden;
}
.scan-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 6rpx;
  transition: width 0.1s;
}
.scan-progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #6366f1;
  margin-top: 12rpx;
}
.scan-actions {
  padding: 0 24rpx 28rpx;
}
.scan-actions .btn {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 0 30rpx rgba(99, 102, 241, 0.4);
}

/* 识别结果弹窗 */
.result-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-box {
  width: 86%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: linear-gradient(135deg, #10b981, #34d399);
}
.result-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 16rpx;
}
.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}
.result-body {
  padding: 28rpx;
}
.result-device {
  display: flex;
  align-items: center;
}
.device-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}
.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.device-code {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}
.result-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}
.result-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.result-item {
  display: flex;
  align-items: center;
}
.item-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #9ca3af;
}
.item-dot.ok { background: #10b981; }
.item-dot.warn { background: #f59e0b; }
.item-dot.error { background: #ef4444; }
.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
}
.item-value {
  font-size: 28rpx;
  font-weight: 600;
}
.item-value.ok { color: #10b981; }
.item-value.warn { color: #f59e0b; }
.item-value.error { color: #ef4444; }
.result-data-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.data-cell {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.data-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}
.data-value {
  font-size: 32rpx;
  font-weight: 700;
}
.result-footer {
  display: flex;
  gap: 20rpx;
  padding: 0 28rpx 28rpx;
}

/* AR巡检记录 */
.record-item {
  background: rgba(15, 23, 42, 0.6);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.15);
}
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.record-device {
  display: flex;
  align-items: center;
}
.record-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e2e8f0;
}
.record-mid {
  display: flex;
  gap: 30rpx;
  margin-bottom: 12rpx;
}
.record-mid .text-sub { color: #94a3b8 !important; }
.record-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-bottom .text-gray { color: #64748b !important; }

/* 底部按钮 */
.ar-bottom {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, #0f172a 40%);
  z-index: 100;
}
.ar-start-btn {
  background: linear-gradient(135deg, #6366f1, #8b5cf6) !important;
  box-shadow: 0 0 40rpx rgba(99, 102, 241, 0.5);
  font-size: 34rpx;
}
.ar-start-btn.scanning {
  background: linear-gradient(135deg, #f59e0b, #ef4444) !important;
  box-shadow: 0 0 40rpx rgba(245, 158, 11, 0.5);
}
.btn-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}
