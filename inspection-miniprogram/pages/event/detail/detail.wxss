/* pages/event/detail/detail.wxss - 事件详情样式 */

.detail-card {
  margin: 20rpx 24rpx;
}
.detail-header {
  margin-bottom: 20rpx;
}
.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.detail-desc {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.detail-info-grid {
  display: flex;
  flex-wrap: wrap;
}
.info-item {
  width: 50%;
  padding: 12rpx 0;
}
.info-item .info-label {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}
.info-item .info-value {
  font-size: 28rpx;
  color: #374151;
}

/* 时间线 */
.timeline-card {
  margin: 20rpx 24rpx;
}
.timeline {
  position: relative;
  padding-left: 8rpx;
}
.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 30rpx;
}
.timeline-item:last-child {
  padding-bottom: 0;
}
.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d1d5db;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #e5e7eb;
  z-index: 1;
}
.timeline-dot.dot-active {
  background: #2563eb;
  box-shadow: 0 0 0 2rpx #2563eb;
}
.timeline-line {
  position: absolute;
  left: 9rpx;
  top: 28rpx;
  bottom: -8rpx;
  width: 2rpx;
  background: #e5e7eb;
}
.timeline-content {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}
.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.timeline-action {
  font-size: 28rpx;
  font-weight: 600;
  color: #2563eb;
}
.timeline-operator {
  margin-bottom: 8rpx;
}
.timeline-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.5;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.closed-tip {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #9ca3af;
  padding: 20rpx 0;
}

/* 跟踪输入弹窗 */
.track-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.track-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
  text-align: center;
}
.track-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.popup-actions {
  display: flex;
  gap: 20rpx;
}
