/* pages/sparepart/inventory/inventory.wxss */

/* 顶部统计 */
.stats-card {
  display: flex;
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-block + .stat-block {
  border-left: 1rpx solid #e5e7eb;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 0 24rpx 16rpx;
  background: transparent;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-clear {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}
.filter-picker {
  flex-shrink: 0;
}
.picker-value {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #6b7280;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.picker-value.active {
  color: #2563eb;
  background: #dbeafe;
}
.picker-text {
  margin-right: 8rpx;
}
.picker-arrow {
  font-size: 20rpx;
}
.filter-actions {
  display: flex;
  gap: 16rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.add-btn {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}
.add-btn:active {
  opacity: 0.9;
}
.import-btn {
  background: #fff;
  color: #2563eb;
  border: 2rpx solid #2563eb;
}
.import-btn:active {
  opacity: 0.9;
}

/* 状态筛选 tab */
.tab-bar-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  margin: 0 24rpx;
  border-radius: 16rpx 16rpx 0 0;
}
.tab-list {
  display: inline-flex;
  padding: 0 12rpx;
}
.tab-item {
  display: inline-flex;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #2563eb;
  border-radius: 3rpx;
}

/* 备件列表 */
.part-list {
  padding: 20rpx 24rpx;
}
.loading-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.part-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid transparent;
}
.part-card.card-warning {
  border-left-color: #ef4444;
}

/* 卡片头部 */
.card-top {
  margin-bottom: 16rpx;
}
.card-top:active {
  opacity: 0.95;
}
.card-title-area {
  flex: 1;
}
.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.part-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.part-code {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 信息行 */
.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.card-info:active {
  opacity: 0.95;
}
.info-item {
  display: flex;
  align-items: center;
  min-width: 45%;
  flex: 1;
}
.info-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
}

/* 库存进度 */
.stock-section {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.stock-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.stock-label {
  font-size: 26rpx;
  color: #6b7280;
}
.stock-value {
  font-size: 32rpx;
  font-weight: 700;
}
.stock-progress {
  margin-bottom: 14rpx;
}
.fill-danger {
  background: linear-gradient(90deg, #ef4444, #f87171) !important;
}
.fill-warning {
  background: linear-gradient(90deg, #f59e0b, #fbbf24) !important;
}
.stock-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 出入库统计 */
.io-stats {
  display: flex;
  gap: 32rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.io-block {
  display: flex;
  align-items: center;
}
.io-arrow {
  font-size: 28rpx;
  margin-right: 8rpx;
  font-weight: 700;
}
.io-in {
  color: #10b981;
}
.io-out {
  color: #ef4444;
}
.io-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* 卡片操作按钮 */
.card-actions {
  display: flex;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slideUp 0.25s ease;
  max-height: 80vh;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.modal-body {
  padding-bottom: 20rpx;
}
.modal-part-info {
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}
.modal-part-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 6rpx;
}
.modal-part-stock {
  font-size: 24rpx;
  color: #6b7280;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 14rpx;
  font-weight: 500;
}
.required {
  color: #ef4444;
  margin-left: 4rpx;
}
.form-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker.placeholder {
  color: #9ca3af;
}
.picker-arrow {
  font-size: 32rpx;
  color: #9ca3af;
}
.form-row {
  display: flex;
  gap: 20rpx;
}
.form-item-half {
  flex: 1;
}

/* 数量输入 */
.qty-input-wrap {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
}
.qty-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.qty-unit {
  font-size: 26rpx;
  color: #9ca3af;
  margin-left: 12rpx;
}
.modal-remark {
  width: 100%;
  min-height: 140rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 添加弹窗滚动区 */
.add-modal-content {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.add-modal-body {
  flex: 1;
  overflow-y: auto;
  max-height: 60vh;
}

/* 底部按钮 */
.modal-footer {
  display: flex;
  padding-top: 10rpx;
}
