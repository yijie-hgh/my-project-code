/* pages/permission/permission.wxss */
.page-bg { padding: 20rpx 20rpx 120rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #374151; margin: 20rpx 0 16rpx; padding-left: 16rpx; border-left: 6rpx solid #2563eb; }
.role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.role-card { background: #fff; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #e5e7eb; }
.role-card.active { border-color: #2563eb; background: #eff6ff; }
.role-icon { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.role-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.role-desc { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.perm-section { margin-top: 32rpx; }
.module-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.module-tab { padding: 10rpx 24rpx; background: #f3f4f6; border-radius: 20rpx; font-size: 24rpx; color: #6b7280; }
.module-tab.active { background: #2563eb; color: #fff; }
.module-group { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.module-title { font-size: 28rpx; font-weight: 600; color: #374151; margin-bottom: 16rpx; text-transform: uppercase; }
.perm-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.perm-check { width: 40rpx; height: 40rpx; border: 2rpx solid #d1d5db; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; margin-right: 16rpx; flex-shrink: 0; }
.perm-check.checked { background: #2563eb; border-color: #2563eb; }
.perm-info { flex: 1; }
.perm-name { font-size: 28rpx; color: #374151; display: block; }
.perm-key { font-size: 22rpx; color: #9ca3af; }
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 20rpx; padding: 20rpx 24rpx; background: #fff; box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.action-btn { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 40rpx; font-size: 28rpx; }
.action-btn.reset { background: #f3f4f6; color: #6b7280; }
.action-btn.save { background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; }
