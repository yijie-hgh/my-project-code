/* pages/plan/list/list.wxss */

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.search-clear {
  font-size: 28rpx;
  color: #9ca3af;
  padding: 10rpx;
}

/* 列表区域 */
.list-wrap {
  padding: 20rpx 24rpx 140rpx;
}

/* 计划卡片 */
.plan-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.plan-card:active {
  background: #fafbfc;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.plan-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.info-label {
  font-size: 26rpx;
  color: #9ca3af;
  width: 140rpx;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #374151;
  flex: 1;
}

/* 标签行 */
.tag-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.mini-tag {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.mini-tag-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}
.mini-tag-text {
  font-size: 22rpx;
  color: #6b7280;
}

/* 巡检人 */
.inspector-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.inspector-label {
  font-size: 26rpx;
  color: #9ca3af;
  flex-shrink: 0;
  line-height: 1.8;
}
.inspector-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}
.inspector-chip {
  background: #e0e7ff;
  color: #6366f1;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 卡片底部 */
.card-bottom {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.next-run {
  display: flex;
  align-items: center;
}
.next-run-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}
.next-run-text {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 500;
}

/* 浮动按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 100;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 85vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.modal-body {
  padding-bottom: 20rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 14rpx;
  font-weight: 500;
}
.required {
  color: #ef4444;
  margin-left: 4rpx;
}
.form-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker .placeholder {
  color: #9ca3af;
}
.picker-arrow {
  font-size: 22rpx;
  color: #9ca3af;
}
.modal-footer {
  display: flex;
  padding-top: 10rpx;
}
