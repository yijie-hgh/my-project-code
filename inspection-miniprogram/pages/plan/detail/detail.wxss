/* pages/plan/detail/detail.wxss */

/* 顶部信息 */
.info-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.info-top {}
.info-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.info-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
  margin-right: 16rpx;
}
.info-tag-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.header-chip {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  color: #fff;
}
.header-chip-icon {
  margin-right: 8rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: #fff;
  margin: -28rpx 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}
.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-block + .stat-block {
  border-left: 1rpx solid #e5e7eb;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}
.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 卡片 */
.card {
  margin: 0 24rpx 20rpx;
}

/* 详细信息行 */
.detail-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-label {
  font-size: 28rpx;
  color: #9ca3af;
  width: 160rpx;
  flex-shrink: 0;
}
.detail-value {
  font-size: 28rpx;
  color: #374151;
  flex: 1;
}
.detail-value-wrap {
  flex: 1;
}

/* 巡检人员 */
.inspector-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.inspector-chip {
  display: flex;
  align-items: center;
  background: #f0f5ff;
  border-radius: 40rpx;
  padding: 8rpx 24rpx 8rpx 8rpx;
}
.inspector-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}
.inspector-name {
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 500;
}

/* 巡检点列表 */
.point-item {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.point-item:active {
  background: #f3f4f6;
}
.point-item:last-child {
  margin-bottom: 0;
}
.point-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.point-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.point-item-info {
  display: flex;
  gap: 30rpx;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}
.page-bg {
  padding-bottom: 140rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 85vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 10rpx;
}
.modal-body {
  padding-bottom: 20rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 14rpx;
  font-weight: 500;
}
.required {
  color: #ef4444;
  margin-left: 4rpx;
}
.form-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker .placeholder {
  color: #9ca3af;
}
.picker-arrow {
  font-size: 22rpx;
  color: #9ca3af;
}
.modal-footer {
  display: flex;
  padding-top: 10rpx;
}
