/* pages/reminder/reminder.wxss */

/* 统计概览 */
.stats-header {
  display: flex;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 40rpx 24rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stats-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}
.stats-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background: #fff;
  margin: -28rpx 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
  gap: 12rpx;
}
.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6b7280;
  transition: all 0.2s;
}
.filter-tab.active {
  background: #2563eb;
  color: #fff;
  font-weight: 500;
}

/* 列表区域 */
.list-wrap {
  padding: 0 24rpx 40rpx;
}

/* 提醒卡片 */
.reminder-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  position: relative;
}
.reminder-card:active {
  background: #fafbfc;
}
.reminder-card.expired {
  border-left: 8rpx solid #ef4444;
}
.reminder-card.soon {
  border-left: 8rpx solid #f59e0b;
}
.reminder-card.normal {
  border-left: 8rpx solid #10b981;
}

/* 左侧图标 */
.reminder-left {
  margin-right: 20rpx;
}
.reminder-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reminder-card.expired .reminder-icon-wrap {
  background: #fee2e2;
}
.reminder-card.soon .reminder-icon-wrap {
  background: #fef3c7;
}
.reminder-card.normal .reminder-icon-wrap {
  background: #d1fae5;
}
.reminder-icon {
  font-size: 40rpx;
}

/* 内容区域 */
.reminder-content {
  flex: 1;
  min-width: 0;
}
.reminder-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.reminder-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.reminder-code {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 16rpx;
}

/* 信息 */
.reminder-info {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.reminder-info-item {
  display: flex;
  align-items: center;
}
.info-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 8rpx;
}
.info-value {
  font-size: 24rpx;
  color: #374151;
}

/* 剩余天数 */
.reminder-days {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.reminder-days.expired {
  color: #ef4444;
  background: #fee2e2;
}
.reminder-days.soon {
  color: #f59e0b;
  background: #fef3c7;
}
.reminder-days.normal {
  color: #10b981;
  background: #d1fae5;
}
