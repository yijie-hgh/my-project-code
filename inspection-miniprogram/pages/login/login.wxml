<!--pages/login/login.wxml-->
<view class="login-page">
  <view class="login-header">
    <view class="header-bg"></view>
    <view class="logo-area">
      <view class="logo-icon">🔍</view>
      <view class="logo-title">设备巡检系统</view>
      <view class="logo-subtitle">Device Inspection System</view>
    </view>
  </view>

  <view class="login-form">
    <view class="form-title">欢迎登录</view>

    <!-- 登录方式Tab -->
    <view class="login-tabs">
      <view class="login-tab {{activeTab === 'account' ? 'active' : ''}}" data-tab="account" bindtap="onTabChange">账号登录</view>
      <view class="login-tab {{activeTab === 'sms' ? 'active' : ''}}" data-tab="sms" bindtap="onTabChange">短信登录</view>
      <view class="login-tab {{activeTab === 'wx' ? 'active' : ''}}" data-tab="wx" bindtap="onTabChange">微信登录</view>
      <view class="login-tab {{activeTab === 'feishu' ? 'active' : ''}}" data-tab="feishu" bindtap="onTabChange">飞书登录</view>
    </view>

    <!-- 账号密码登录 -->
    <view wx:if="{{activeTab === 'account'}}" class="input-group">
      <view class="input-item">
        <text class="input-icon">👤</text>
        <input class="input-field" placeholder="请输入用户名" value="{{username}}" data-field="username" bindinput="onInput" maxlength="20"></input>
      </view>
      <view class="input-item">
        <text class="input-icon">🔒</text>
        <input class="input-field" placeholder="请输入密码" password value="{{password}}" data-field="password" bindinput="onInput" maxlength="20"></input>
      </view>
      <view class="forgot-row">
        <text class="forgot-link" bindtap="showResetModal">忘记密码？</text>
      </view>
    </view>

    <!-- 短信验证码登录 -->
    <view wx:if="{{activeTab === 'sms'}}" class="input-group">
      <view class="input-item">
        <text class="input-icon">📱</text>
        <input class="input-field" placeholder="请输入手机号" type="number" value="{{phone}}" data-field="phone" bindinput="onInput" maxlength="11"></input>
      </view>
      <view class="input-item sms-item">
        <text class="input-icon">🔢</text>
        <input class="input-field" placeholder="短信验证码" type="number" value="{{smsCode}}" data-field="smsCode" bindinput="onInput" maxlength="6"></input>
        <view class="sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}" bindtap="{{smsCountdown > 0 ? '' : 'onSendSms'}}">
          <text wx:if="{{smsCountdown > 0}}">{{smsCountdown}}s</text>
          <text wx:elif="{{smsSending}}">发送中...</text>
          <text wx:else>获取验证码</text>
        </view>
      </view>
    </view>

    <!-- 微信登录 -->
    <view wx:if="{{activeTab === 'wx'}}" class="third-party-login">
      <view class="tp-icon-large">💬</view>
      <view class="tp-desc">使用微信账号一键登录</view>
      <view class="tp-desc">将自动绑定您的微信信息</view>
    </view>

    <!-- 飞书登录 -->
    <view wx:if="{{activeTab === 'feishu'}}" class="third-party-login">
      <view class="tp-icon-large">🔗</view>
      <view class="tp-desc">使用飞书账号登录</view>
      <view class="tp-desc" wx:if="{{feishuLoggedIn}}">已绑定：{{feishuAccount.name}}</view>
      <view class="tp-desc" wx:else>将自动绑定您的飞书信息</view>
    </view>

    <!-- 协议 -->
    <view class="agree-row">
      <checkbox-group bindchange="onAgree">
        <label class="agree-label">
          <checkbox value="1" color="#2563eb" />
          <text>我已阅读并同意</text>
          <text class="protocol-link" bindtap="onProtocol">《用户协议与隐私政策》</text>
        </label>
      </checkbox-group>
    </view>

    <!-- 登录按钮 -->
    <button wx:if="{{activeTab === 'account'}}" class="btn btn-primary btn-block login-btn" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}">登 录</button>
    <button wx:if="{{activeTab === 'sms'}}" class="btn btn-primary btn-block login-btn" bindtap="onSmsLogin" loading="{{loading}}" disabled="{{loading}}">短信登录</button>
    <button wx:if="{{activeTab === 'wx'}}" class="wx-login-btn" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading}}">
      <text class="wx-icon">💬</text>
      <text>微信一键登录</text>
    </button>
    <button wx:if="{{activeTab === 'feishu'}}" class="feishu-login-btn" bindtap="onFeishuLogin" loading="{{loading}}" disabled="{{loading}}">
      <text class="feishu-icon">🔗</text>
      <text>飞书账号登录</text>
    </button>

    <!-- 分割线 -->
    <view class="divider-row">
      <view class="divider-line"></view>
      <text class="divider-text">其他登录方式</text>
      <view class="divider-line"></view>
    </view>

    <!-- 快捷登录 -->
    <view class="quick-login-row">
      <view wx:if="{{activeTab !== 'account'}}" class="quick-btn quick-account" bindtap="onTabChange" data-tab="account">👤 账号</view>
      <view wx:if="{{activeTab !== 'sms'}}" class="quick-btn quick-sms" bindtap="onTabChange" data-tab="sms">📱 短信</view>
      <view wx:if="{{activeTab !== 'wx'}}" class="quick-btn quick-wx" bindtap="onTabChange" data-tab="wx">💬 微信</view>
      <view wx:if="{{activeTab !== 'feishu'}}" class="quick-btn quick-feishu" bindtap="onTabChange" data-tab="feishu">🔗 飞书</view>
    </view>

    <!-- 注册 -->
    <view class="register-link" bindtap="goRegister">没有账号？立即注册</view>
  </view>

  <view class="login-footer">
    <text>基于若依框架 · 前后端分离 · 开源系统</text>
  </view>
</view>

<!-- 忘记密码弹窗 -->
<view wx:if="{{showResetModal}}" class="modal-mask" bindtap="hideResetModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">重置密码</text>
      <text class="modal-close" bindtap="hideResetModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="input-item">
        <text class="input-icon">📱</text>
        <input class="input-field" placeholder="注册手机号" type="number" value="{{resetForm.phone}}" data-field="phone" bindinput="onResetInput" maxlength="11"></input>
      </view>
      <view class="input-item sms-item">
        <text class="input-icon">🔢</text>
        <input class="input-field" placeholder="短信验证码" type="number" value="{{resetForm.smsCode}}" data-field="smsCode" bindinput="onResetInput" maxlength="6"></input>
        <view class="sms-btn {{resetSmsCountdown > 0 ? 'disabled' : ''}}" bindtap="{{resetSmsCountdown > 0 ? '' : 'onSendResetSms'}}">
          <text wx:if="{{resetSmsCountdown > 0}}">{{resetSmsCountdown}}s</text>
          <text wx:else>获取验证码</text>
        </view>
      </view>
      <view class="input-item">
        <text class="input-icon">🔑</text>
        <input class="input-field" placeholder="新密码（至少6位）" password value="{{resetForm.newPassword}}" data-field="newPassword" bindinput="onResetInput" maxlength="20"></input>
      </view>
      <view class="input-item">
        <text class="input-icon">🔒</text>
        <input class="input-field" placeholder="确认新密码" password value="{{resetForm.confirmPassword}}" data-field="confirmPassword" bindinput="onResetInput" maxlength="20"></input>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn-cancel" bindtap="hideResetModal">取消</button>
      <button class="modal-btn-confirm" bindtap="onResetPassword">确认重置</button>
    </view>
  </view>
</view>
