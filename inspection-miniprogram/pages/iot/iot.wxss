/* pages/iot/iot.wxss - 物联网数采页样式 */
.iot-page {
  padding-bottom: 160rpx;
}

/* 概览卡片 */
.overview-card {
  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
}
.overview-card .card-title {
  color: #fff;
}
.overview-card .card-title::before {
  background: #fff;
}
.overview-title {
  margin-bottom: 20rpx;
}
.overview-stats {
  display: flex;
  justify-content: space-around;
}
.stat-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}
.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}
.dot-online {
  background: #10b981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}
.dot-offline {
  background: #9ca3af;
}
.stat-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}
.stat-block .text-success,
.stat-block .text-gray,
.stat-block .text-danger {
  color: #fff;
}

/* 刷新栏 */
.refresh-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.refresh-btn {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #6b7280;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.refresh-btn.active {
  background: #dbeafe;
  color: #2563eb;
}
.refresh-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}
.refresh-icon.spinning {
  animation: spin 2s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.refresh-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.last-time {
  white-space: nowrap;
}
.manual-refresh {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #2563eb;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.manual-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

/* 过滤Tab */
.filter-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.2s;
}
.filter-tab.active {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.3);
}
.tab-count {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 加载/空状态 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 设备卡片 */
.device-card {
  position: relative;
  overflow: hidden;
  transition: all 0.2s;
}
.device-card:active {
  transform: scale(0.99);
}
.device-alert {
  border: 2rpx solid #ef4444;
  box-shadow: 0 2rpx 16rpx rgba(239, 68, 68, 0.15);
}
.device-offline {
  opacity: 0.85;
  background: #fafafa;
}

/* 告警条 */
.alert-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #fee2e2, #fef3c7);
  color: #ef4444;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.alert-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

/* 设备头部 */
.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.device-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.device-status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.dot-online {
  background: #10b981;
  box-shadow: 0 0 10rpx rgba(16, 185, 129, 0.5);
}
.dot-offline {
  background: #9ca3af;
}
.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  max-width: 360rpx;
}
.device-code {
  margin-top: 4rpx;
}

/* 更新时间 */
.device-update {
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 传感器网格 */
.sensor-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.sensor-item {
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 20rpx;
  border-left: 6rpx solid #e5e7eb;
}
.sensor-item.sensor-normal {
  border-left-color: #10b981;
  background: #f0fdf4;
}
.sensor-item.sensor-warning {
  border-left-color: #f59e0b;
  background: #fffbeb;
}
.sensor-item.sensor-danger {
  border-left-color: #ef4444;
  background: #fef2f2;
}
.sensor-item.sensor-offline {
  border-left-color: #9ca3af;
  background: #f9fafb;
}
.sensor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.sensor-name {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
}
.sensor-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.sensor-value-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 12rpx;
}
.sensor-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}
.sensor-unit {
  font-size: 22rpx;
  color: #9ca3af;
}
.sensor-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sensor-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 5rpx;
}
.sensor-bar .progress-bar-fill {
  transition: width 0.4s;
}
.sensor-threshold {
  white-space: nowrap;
}

/* 设备底部 */
.device-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: right;
}

/* 卡片快捷操作 */
.card-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 12rpx 0;
}
.action-btn:active {
  opacity: 0.7;
}
.action-btn.danger {
  color: #ef4444;
  background: #fef2f2;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 99;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 表单弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.detail-popup {
  width: 100%;
  background: #f5f7fa;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.popup-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 8rpx;
}
.popup-scroll {
  flex: 1;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-item-row .form-label {
  margin-bottom: 0;
}
.required {
  color: #ef4444;
}
.form-input {
  width: 100%;
  height: 72rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}
.form-picker.placeholder {
  color: #9ca3af;
}
.picker-arrow {
  color: #9ca3af;
  font-size: 32rpx;
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

/* 表单底部操作按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
}
.form-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-weight: 500;
}
.form-btn:active {
  opacity: 0.85;
}
.form-btn-cancel {
  background: #fff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
}
.form-btn-save {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}
