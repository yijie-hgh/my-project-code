/* pages/mine/feedback/feedback.wxss */

/* 反馈类型 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.type-item {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #f9fafb;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: #6b7280;
  transition: all 0.2s;
}
.type-item.active {
  background: #dbeafe;
  border-color: #2563eb;
  color: #2563eb;
  font-weight: 600;
}
.type-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 反馈内容 */
.feedback-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
  padding: 16rpx 0;
}
.textarea-placeholder {
  color: #9ca3af;
}
.word-count {
  display: flex;
  justify-content: flex-end;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}
.image-add:active {
  background: #f3f4f6;
}
.add-icon {
  font-size: 56rpx;
  color: #9ca3af;
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 联系方式 */
.contact-input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #1f2937;
  border-bottom: 1rpx solid #f0f0f0;
}
.input-placeholder {
  color: #9ca3af;
}

/* 提交按钮禁用状态 */
.btn.disabled {
  opacity: 0.6;
}

/* 提示 */
.feedback-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
}
.tip-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #9ca3af;
}
