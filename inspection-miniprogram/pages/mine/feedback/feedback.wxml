<!--pages/mine/feedback/feedback.wxml-->
<view class="page-bg container">
  <!-- 反馈类型 -->
  <view class="card">
    <view class="card-title">反馈类型</view>
    <view class="type-list">
      <view class="type-item {{feedbackType === item.value ? 'active' : ''}}"
            wx:for="{{typeList}}" wx:key="value"
            data-value="{{item.value}}" bindtap="onTypeChange">
        <text class="type-icon">{{item.icon}}</text>
        <text>{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 反馈内容 -->
  <view class="card">
    <view class="card-title">反馈内容</view>
    <textarea class="feedback-textarea"
              value="{{content}}"
              bindinput="onContentInput"
              placeholder="请详细描述您遇到的问题或建议（至少10个字）"
              placeholder-class="textarea-placeholder"
              maxlength="500"
              auto-height></textarea>
    <view class="word-count">
      <text class="{{content.length < 10 ? 'text-warning' : 'text-gray'}}">{{content.length}}</text>
      <text class="text-gray">/500</text>
    </view>
  </view>

  <!-- 添加图片 -->
  <view class="card">
    <view class="card-title">添加图片（最多3张）</view>
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="path" wx:for-item="img" wx:for-index="idx">
        <image src="{{img.path}}" mode="aspectFill" class="preview-img" data-index="{{idx}}" bindtap="onPreviewImage"></image>
        <view class="image-delete" data-index="{{idx}}" catchtap="onDeleteImage">✕</view>
      </view>
      <view class="image-add" wx:if="{{images.length < 3}}" bindtap="onAddImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="card">
    <view class="card-title">联系方式（选填）</view>
    <input class="contact-input"
           value="{{contact}}"
           bindinput="onContactInput"
           placeholder="请输入手机号或邮箱，方便我们与您联系"
           placeholder-class="input-placeholder" />
  </view>

  <!-- 提交按钮 -->
  <view class="btn btn-primary btn-block mt-20 {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? '提交中...' : '提交反馈'}}
  </view>

  <view class="feedback-tip">
    <text class="tip-icon">💡</text>
    <text class="tip-text">您的反馈对我们非常重要，我们会认真阅读每一条建议</text>
  </view>
</view>
