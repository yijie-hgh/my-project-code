/* pages/scan/scan.wxss */
.scan-page { padding: 0 24rpx; }

.scan-area {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.scan-bg {
  width: 460rpx;
  height: 460rpx;
  background: linear-gradient(135deg, #1e3a5f, #1d4ed8);
  border-radius: 32rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(37, 99, 235, 0.3);
}
.scan-frame {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
}
.scan-frame.hidden { opacity: 0.3; }
.frame-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 6rpx solid #fff;
}
.frame-corner.tl { top: 0; left: 0; border-right: none; border-bottom: none; border-radius: 12rpx 0 0 0; }
.frame-corner.tr { top: 0; right: 0; border-left: none; border-bottom: none; border-radius: 0 12rpx 0 0; }
.frame-corner.bl { bottom: 0; left: 0; border-right: none; border-top: none; border-radius: 0 0 0 12rpx; }
.frame-corner.br { bottom: 0; right: 0; border-left: none; border-top: none; border-radius: 0 0 12rpx 0; }
.scan-beam {
  position: absolute;
  top: 10%;
  left: 6rpx;
  right: 6rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #3b82f6, #fff, #3b82f6, transparent);
  box-shadow: 0 0 20rpx #3b82f6;
  animation: scanBeam 2s ease-in-out infinite;
}
@keyframes scanBeam {
  0%, 100% { top: 10%; }
  50% { top: 88%; }
}
.scan-center-icon {
  font-size: 80rpx;
  z-index: 1;
}

.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}
.type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.type-tab.active {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
}
.type-icon { font-size: 40rpx; margin-bottom: 8rpx; }
.type-tab text { font-size: 24rpx; color: #6b7280; }
.type-tab.active text { color: #fff; font-weight: 600; }

.scan-actions { margin-bottom: 32rpx; }
.scan-tip {
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}
.scan-btn { height: 96rpx; font-size: 34rpx; }
.scan-btn.locating { opacity: 0.7; }

.location-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.loc-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.loc-row:last-child { border-bottom: none; }
.loc-label { font-size: 26rpx; color: #6b7280; }
.loc-val { font-size: 26rpx; color: #1f2937; font-weight: 600; }

.scan-help { margin: 0; }
.help-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #4b5563;
}
.help-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #dbeafe;
  color: #2563eb;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-weight: 600;
}
