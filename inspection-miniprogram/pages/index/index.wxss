/* pages/index/index.wxss */
.home-header {
  background: linear-gradient(180deg, #2563eb, #1d4ed8);
  padding: 30rpx 24rpx 60rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.user-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.greeting {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.dept {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}
.header-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quick-section {
  padding: 0 24rpx;
  margin-top: -36rpx;
}
.quick-grid {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}
.quick-item text {
  font-size: 22rpx;
  color: #4b5563;
}

/* 趋势图 */
.trend-card { margin: 20rpx 24rpx; }
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding: 20rpx 0;
}
.trend-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 200rpx;
}
.trend-bar {
  width: 16rpx;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
  transition: height 0.5s;
}
.bar-done { background: linear-gradient(180deg, #3b82f6, #2563eb); }
.bar-abnormal { background: linear-gradient(180deg, #f87171, #ef4444); }
.trend-date {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}
.trend-num {
  font-size: 20rpx;
  color: #2563eb;
  font-weight: 600;
}
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 12rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6b7280;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}
.legend-dot.done { background: #2563eb; }
.legend-dot.abnormal { background: #ef4444; }

/* 完成率 */
.rate-list { display: flex; flex-direction: column; gap: 24rpx; }
.rate-item {}
.rate-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.rate-name { font-size: 28rpx; color: #374151; }
.rate-value { font-size: 28rpx; font-weight: 600; color: #2563eb; }

/* 事件概览 */
.event-stats {
  display: flex;
  justify-content: space-around;
}
.event-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.event-num {
  font-size: 44rpx;
  font-weight: 700;
}
.event-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

/* 任务卡片 */
.task-card {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.task-card:active { background: #f3f4f6; }
.task-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.task-name { font-size: 30rpx; font-weight: 600; color: #1f2937; flex: 1; }
.task-card-mid {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}
.task-card-bottom {
  display: flex;
  align-items: center;
}

.card { margin: 20rpx 24rpx; }
