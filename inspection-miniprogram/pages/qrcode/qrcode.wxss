/* pages/qrcode/qrcode.wxss */

/* 巡检点选择picker */
.picker-box {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
}
.picker-label {
  font-size: 28rpx;
  color: #6b7280;
  margin-right: 16rpx;
}
.picker-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}
.picker-value.placeholder {
  color: #9ca3af;
  font-weight: 400;
}
.picker-arrow {
  font-size: 40rpx;
  color: #9ca3af;
}

/* 二维码卡片 */
.qr-card {
  text-align: center;
}
.qr-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  margin: 30rpx 0;
}
.qr-canvas {
  width: 280px;
  height: 280px;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}
.qr-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: #9ca3af;
}

/* 二维码信息 */
.qr-info {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #6b7280;
}
.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

/* 操作按钮 */
.qr-actions {
  display: flex;
  gap: 20rpx;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-icon.loading-icon {
  animation: spin 1.5s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 说明列表 */
.help-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.help-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}
.help-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
