/* pages/spotcheck/execute/execute.wxss */
.equip-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  padding: 32rpx 28rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.equip-header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}
.equip-header-info {
  flex: 1;
}
.equip-header-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.equip-header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.section {
  padding: 20rpx 24rpx 0;
}
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.section-title-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.check-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.check-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.check-name-area {
  display: flex;
  align-items: center;
}
.check-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-right: 12rpx;
}
.required-tag {
  font-size: 20rpx;
  color: #ef4444;
  background: #fee2e2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.check-type-tag {
  font-size: 22rpx;
  color: #9ca3af;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 单选选项 */
.choice-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.choice-option {
  flex: 1;
  min-width: 140rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: #6b7280;
  transition: all 0.2s;
}
.choice-option.active.opt-normal {
  background: #d1fae5;
  color: #10b981;
  border-color: #10b981;
  font-weight: 600;
}
.choice-option.active.opt-abnormal {
  background: #fee2e2;
  color: #ef4444;
  border-color: #ef4444;
  font-weight: 600;
}

/* 拍照区域 */
.photo-area {
  margin-top: 4rpx;
}
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #d1d5db;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.photo-add-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
}

/* 空提示 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 异常提示 */
.abnormal-tip {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #fff7ed;
  border-radius: 16rpx;
  border: 2rpx solid #fed7aa;
}
.abnormal-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.abnormal-tip text:last-child {
  font-size: 26rpx;
  color: #c2410c;
  flex: 1;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
