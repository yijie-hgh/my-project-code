/* pages/spotcheck/stats/stats.wxss - 点检统计看板样式 */
.stats-page {
  padding-bottom: 40rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

/* ============ 顶部统计卡片 ============ */
.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.stat-blue {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
}
.stat-green {
  background: linear-gradient(135deg, #10b981, #34d399);
}
.stat-red {
  background: linear-gradient(135deg, #ef4444, #f87171);
}
.stat-orange {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}
.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}
.stat-name {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: 0.9;
}

/* ============ 合格率区域 ============ */
.pass-rate-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pass-rate-display {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.pass-rate-big {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}
.pass-rate-desc {
  font-size: 26rpx;
}
.pass-rate-progress {
  height: 20rpx;
  border-radius: 10rpx;
}
.pass-rate-progress .progress-bar-fill {
  border-radius: 10rpx;
}
.pass-rate-info {
  display: flex;
  gap: 40rpx;
}
.pass-rate-info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pass-rate-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.dot-normal {
  background: #10b981;
}
.dot-abnormal {
  background: #ef4444;
}

/* ============ 图例 ============ */
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.chart-legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6b7280;
}
.chart-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

/* ============ 类型分布列表（堆叠柱状图） ============ */
.type-dist-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.type-dist-item {
  width: 100%;
}
.type-dist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.type-dist-name {
  font-size: 26rpx;
  color: #374151;
}
.type-dist-rate {
  font-size: 28rpx;
  font-weight: 700;
}
.type-dist-bar {
  display: flex;
  height: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}
.type-dist-bar-normal {
  background: linear-gradient(90deg, #10b981, #34d399);
  transition: width 0.5s ease;
}
.type-dist-bar-abnormal {
  background: linear-gradient(90deg, #ef4444, #f87171);
  transition: width 0.5s ease;
}
.type-dist-info {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

/* ============ 趋势图（双柱状图） ============ */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 320rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid #e5e7eb;
}
.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 280rpx;
  width: 100%;
  justify-content: center;
}
.trend-bar {
  width: 22rpx;
  min-height: 4rpx;
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.5s ease;
}
.trend-bar-normal {
  background: linear-gradient(180deg, #34d399, #10b981);
}
.trend-bar-abnormal {
  background: linear-gradient(180deg, #f87171, #ef4444);
}
.trend-date {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 12rpx;
}
.trend-num {
  margin-top: 4rpx;
  color: #6b7280;
}

/* ============ 常见异常项Top5 ============ */
.top-abnormal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.top-abnormal-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.top-abnormal-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rank-1 {
  background: linear-gradient(135deg, #ef4444, #f87171);
}
.rank-2 {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}
.rank-3 {
  background: linear-gradient(135deg, #f59e0b, #fcd34d);
}
.rank-4 {
  background: linear-gradient(135deg, #6366f1, #818cf8);
}
.rank-5 {
  background: linear-gradient(135deg, #6b7280, #9ca3af);
}
.top-abnormal-info {
  flex: 1;
}
.top-abnormal-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.top-abnormal-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}
.top-abnormal-count {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 600;
}
.top-abnormal-percent {
  margin-top: 6rpx;
}

/* ============ 刷新按钮 ============ */
.refresh-footer {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #2563eb;
}
