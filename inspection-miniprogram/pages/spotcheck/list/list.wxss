/* pages/spotcheck/list/list.wxss */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}

.tab-bar-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab-list {
  display: inline-flex;
  padding: 0 12rpx;
}
.tab-item {
  display: inline-flex;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #2563eb;
  border-radius: 3rpx;
}

.record-list {
  padding: 20rpx 24rpx;
}
.record-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.record-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.card-title-area {
  flex: 1;
  margin-right: 16rpx;
}
.equip-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
}
.equip-code {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 6rpx;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.info-item {
  display: flex;
  align-items: center;
}
.info-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.info-text {
  font-size: 24rpx;
  color: #6b7280;
}

.card-remark {
  font-size: 24rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.card-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.check-item {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}
.check-item-name {
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 10rpx;
}
.check-item-value {
  font-size: 24rpx;
  font-weight: 600;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 99;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.detail-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.popup-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 8rpx;
}
.popup-body {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.popup-equip-header {
  margin-bottom: 20rpx;
}
.popup-equip-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  flex: 1;
  margin-right: 16rpx;
}
.popup-equip-code {
  font-size: 24rpx;
  color: #2563eb;
  display: block;
  margin-top: 8rpx;
}
.popup-info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}
.popup-info-label {
  font-size: 28rpx;
  color: #6b7280;
}
.popup-info-value {
  font-size: 28rpx;
  color: #1f2937;
}
.popup-divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 16rpx 0;
}
.popup-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
}
.popup-check-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.popup-check-name {
  font-size: 28rpx;
  color: #4b5563;
}
.popup-remark {
  margin-top: 20rpx;
}
.popup-remark-content {
  font-size: 28rpx;
  color: #4b5563;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.6;
}

/* 统计概览 */
.mini-stats {
  display: flex;
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.mini-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.mini-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}
.mini-stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* 卡片快捷操作 */
.card-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 12rpx 0;
}
.action-btn:active {
  opacity: 0.7;
}
.action-btn.danger {
  color: #ef4444;
  background: #fef2f2;
}

/* 弹窗滚动区域 */
.popup-scroll {
  max-height: 70vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 关联模块区域 */
.related-loading {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #9ca3af;
}
.related-section {
  margin-bottom: 24rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
}
.related-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.related-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}
.related-action {
  font-size: 24rpx;
  color: #2563eb;
  padding: 4rpx 16rpx;
  border: 1rpx solid #2563eb;
  border-radius: 20rpx;
}
.related-empty {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  padding: 12rpx 0;
}
.related-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}
.related-item:last-child {
  border-bottom: none;
}
.related-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.related-item-title {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
  flex: 1;
  margin-right: 12rpx;
}
.related-item-desc {
  font-size: 22rpx;
}

/* 物联网传感器 */
.iot-sensors {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.iot-sensor-item {
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  flex: 1;
  min-width: 140rpx;
}
.iot-sensor-name {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
}
.iot-sensor-value {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

/* 弹窗底部操作 */
.popup-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e7eb;
}
.popup-action-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 12rpx;
  padding: 16rpx 0;
}
.popup-action-btn:active {
  opacity: 0.7;
}

/* ========== 视图工具栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
}
.search-input-wrap {
  flex: 1;
}
.view-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  transition: all 0.2s;
}
.tool-btn:active {
  background: #e5e7eb;
  transform: scale(0.95);
}
.tool-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* ========== 表格视图 ========== */
.table-view-wrap {
  padding: 16rpx 24rpx 140rpx;
}
.table-scroll {
  width: 100%;
  max-height: calc(100vh - 400rpx);
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.table-header {
  display: flex;
  background: #f8fafc;
  border-bottom: 2rpx solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 2;
}
.table-cell {
  padding: 20rpx 16rpx;
  font-size: 26rpx;
  color: #374151;
  flex-shrink: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.table-cell-head {
  font-weight: 600;
  color: #1f2937;
  background: #f8fafc;
}
.table-cell-idx {
  width: 60rpx;
  text-align: center;
  color: #9ca3af;
  flex-shrink: 0;
}
.table-row {
  display: flex;
  border-bottom: 1rpx solid #f3f4f6;
  transition: background 0.2s;
}
.table-row:active {
  background: #f9fafb;
}
.table-cell-action {
  width: 100rpx;
  text-align: center;
  flex-shrink: 0;
}
.row-action-btn {
  color: #2563eb;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  background: #eff6ff;
  border-radius: 8rpx;
}

/* ========== 弹窗通用 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-popup {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.popup-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  padding: 0 32rpx 20rpx;
}

/* ========== 字段配置弹窗 ========== */
.field-config-popup {
  max-height: 80vh;
}
.field-config-scroll {
  flex: 1;
  padding: 0 32rpx;
  max-height: 60vh;
}
.field-group {
  margin-bottom: 32rpx;
}
.field-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #2563eb;
}
.field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.field-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.field-item.selected {
  background: #eff6ff;
  border-color: #2563eb;
}
.field-item.required {
  opacity: 0.9;
}
.field-checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}
.field-item.selected .field-checkbox {
  background: #2563eb;
  border-color: #2563eb;
}
.field-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.field-label {
  font-size: 26rpx;
  color: #374151;
}
.field-badge {
  font-size: 20rpx;
  color: #ef4444;
  background: #fef2f2;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* ========== 导入弹窗 ========== */
.import-popup {
  max-height: 80vh;
}
.import-content {
  padding: 20rpx 32rpx;
}
.import-tip {
  background: #eff6ff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.import-tip text {
  font-size: 26rpx;
  color: #2563eb;
}
.import-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.import-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.import-btn.primary {
  background: #eff6ff;
  border-color: #2563eb;
  border-style: solid;
}
.import-btn:active {
  transform: scale(0.98);
}
.import-btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.import-btn-text {
  font-size: 26rpx;
  color: #374151;
}
.import-btn.primary .import-btn-text {
  color: #2563eb;
  font-weight: 500;
}

/* 导入结果 */
.import-result {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
.result-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.result-status.success {
  background: #dcfce7;
  color: #16a34a;
}
.result-status.fail {
  background: #fee2e2;
  color: #dc2626;
}
.result-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}
.stat-label {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}
.result-errors {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.errors-title {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}
.error-item {
  font-size: 24rpx;
  color: #ef4444;
  padding: 6rpx 0;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-success {
  background: #dcfce7;
  color: #16a34a;
}
.tag-danger {
  background: #fee2e2;
  color: #dc2626;
}
.tag-warning {
  background: #fef3c7;
  color: #d97706;
}
.tag-info {
  background: #dbeafe;
  color: #2563eb;
}
.tag-gray {
  background: #f3f4f6;
  color: #6b7280;
}
.tag-primary {
  background: #dbeafe;
  color: #2563eb;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 文字颜色辅助 */
.text-primary {
  color: #2563eb;
}
.text-success {
  color: #16a34a;
}
.text-danger {
  color: #dc2626;
}
.text-warning {
  color: #d97706;
}
.text-gray {
  color: #9ca3af;
}
.text-sm {
  font-size: 22rpx;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
