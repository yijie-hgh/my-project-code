/* pages/maintain/list/list.wxss */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.feishu-sync-btn {
  padding: 10rpx 20rpx;
  background: #ecfdf5;
  color: #10b981;
  border: 1rpx solid #10b981;
  border-radius: 20rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}

.tab-bar-scroll {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab-list {
  display: inline-flex;
  padding: 0 12rpx;
}
.tab-item {
  display: inline-flex;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab-item.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #2563eb;
  border-radius: 3rpx;
}

.maintain-list {
  padding: 20rpx 24rpx;
}
.maintain-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid transparent;
}
.maintain-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}
.maintain-card.overdue {
  border-left-color: #ef4444;
  background: #fef2f2;
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.card-title-area {
  flex: 1;
  margin-right: 16rpx;
}
.maintain-no {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 6rpx;
}
.maintain-plan {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
}

.card-info {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.info-item {
  display: flex;
  align-items: center;
}
.info-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.info-text {
  font-size: 24rpx;
  color: #6b7280;
}

.card-content {
  font-size: 24rpx;
  color: #9ca3af;
  background: #f9fafb;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.card-progress {
  display: flex;
  align-items: center;
}
.progress-text {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}
.fill-danger {
  background: linear-gradient(90deg, #ef4444, #f87171) !important;
}

/* 卡片操作按钮 */
.card-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 8rpx;
  padding: 12rpx 0;
}
.action-btn:active {
  opacity: 0.7;
}
.action-btn.danger {
  color: #ef4444;
  background: #fef2f2;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 99;
}
.fab-btn:active {
  transform: scale(0.92);
  opacity: 0.9;
}
.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 表单弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.detail-popup {
  width: 100%;
  background: #f5f5f5;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
}
.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.popup-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 8rpx;
}

/* 表单滚动区域 */
.form-scroll {
  max-height: 70vh;
  padding: 20rpx 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 表单字段 */
.form-item {
  margin-bottom: 24rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}
.required {
  color: #ef4444;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
}
.form-picker.placeholder {
  color: #9ca3af;
}
.picker-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

/* 底部按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.form-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 24rpx 0;
}
.cancel-btn {
  background: #f3f4f6;
  color: #6b7280;
}
.cancel-btn:active {
  opacity: 0.7;
}
.submit-btn {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
}
.submit-btn:active {
  opacity: 0.85;
}
