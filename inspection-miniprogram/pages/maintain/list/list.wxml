<!--pages/maintain/list/list.wxml-->
<view class="page-bg" style="padding-bottom: 140rpx;">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索设备名称" value="{{queryParams.equipName}}" bindinput="onSearch" confirm-type="search"></input>
    </view>
    <view class="feishu-sync-btn" bindtap="onSyncToFeishu">
      <text>🔗飞书</text>
    </view>
  </view>

  <!-- 状态筛选 -->
  <scroll-view class="tab-bar-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
    <view class="tab-list">
      <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTabChange">
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 保养列表 -->
  <view class="maintain-list">
    <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无保养记录" icon="🔧" subText="点击右下角按钮添加保养计划"></empty-state>

    <view wx:for="{{list}}" wx:key="id" class="maintain-card {{item.overdue ? 'overdue' : ''}}" data-id="{{item.id}}" bindtap="goDetail">
      <view class="card-top">
        <view class="card-title-area">
          <text class="maintain-no">🔧 {{item.maintainNo}}</text>
          <text class="maintain-plan">{{item.planName}}</text>
        </view>
        <text class="tag {{item.statusInfo.tag}}">{{item.statusInfo.text}}</text>
      </view>

      <view class="card-info">
        <view class="info-item">
          <text class="info-icon">🏭</text>
          <text class="info-text">{{item.equipName}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">📋</text>
          <text class="info-text">{{item.type}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">👤</text>
          <text class="info-text">{{item.maintainer}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">📅</text>
          <text class="info-text {{item.overdue ? 'text-danger' : ''}}">{{item.planDate}}</text>
        </view>
      </view>

      <view wx:if="{{item.content}}" class="card-content text-ellipsis">📝 {{item.content}}</view>

      <view class="card-progress">
        <view class="progress-bar" style="flex:1;margin-right:20rpx;">
          <view class="progress-bar-fill {{item.overdue ? 'fill-danger' : ''}}" style="width: {{item.rate}}%;"></view>
        </view>
        <text class="progress-text">{{item.doneCount}}/{{item.totalCount}}项</text>
      </view>

      <!-- 卡片操作按钮 -->
      <view class="card-actions" catchtap="">
        <view class="action-btn" data-id="{{item.id}}" catchtap="onEdit">
          <text>✏️ 编辑</text>
        </view>
        <view class="action-btn danger" data-id="{{item.id}}" catchtap="onDelete">
          <text>🗑️ 删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮按钮 -->
  <view class="fab-btn" bindtap="onAdd">
    <text class="fab-icon">+</text>
  </view>

  <!-- 表单弹窗 -->
  <view class="detail-mask" wx:if="{{showForm}}" bindtap="onCloseForm">
    <view class="detail-popup" catchtap="stopPropagation">
      <view class="popup-header">
        <text class="popup-title">{{formMode === 'edit' ? '编辑保养计划' : '新增保养计划'}}</text>
        <text class="popup-close" bindtap="onCloseForm">✕</text>
      </view>

      <scroll-view scroll-y class="form-scroll">
        <!-- 基本信息 -->
        <view class="card">
          <view class="card-title">📋 基本信息</view>

          <view class="form-item">
            <text class="form-label">计划名称 <text class="required">*</text></text>
            <input class="form-input" placeholder="请输入计划名称" value="{{form.planName}}" data-field="planName" bindinput="onFormInput" />
          </view>

          <view class="form-item">
            <text class="form-label">关联设备 <text class="required">*</text></text>
            <picker mode="selector" range="{{equipList}}" range-key="equipName" value="{{form.equipIndex}}" bindchange="onEquipChange">
              <view class="form-picker {{form.equipName ? '' : 'placeholder'}}">
                <text>{{form.equipName || '请选择设备'}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-item">
            <text class="form-label">保养类型 <text class="required">*</text></text>
            <picker mode="selector" range="{{maintainTypes}}" range-key="typeName" value="{{form.typeIndex}}" bindchange="onTypeChange">
              <view class="form-picker {{form.type ? '' : 'placeholder'}}">
                <text>{{form.type || '请选择保养类型'}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-item">
            <text class="form-label">计划日期 <text class="required">*</text></text>
            <picker mode="date" value="{{form.planDate}}" bindchange="onDateChange">
              <view class="form-picker {{form.planDate ? '' : 'placeholder'}}">
                <text>{{form.planDate || '请选择日期'}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </picker>
          </view>

          <view class="form-item">
            <text class="form-label">保养人</text>
            <input class="form-input" placeholder="请输入保养人" value="{{form.maintainer}}" data-field="maintainer" bindinput="onFormInput" />
          </view>
        </view>

        <!-- 保养详情 -->
        <view class="card">
          <view class="card-title">📝 保养详情</view>

          <view class="form-item">
            <text class="form-label">保养内容</text>
            <textarea class="form-textarea" placeholder="请输入保养内容" value="{{form.content}}" data-field="content" bindinput="onFormInput" maxlength="500" />
          </view>

          <view class="form-item">
            <text class="form-label">备注</text>
            <textarea class="form-textarea" placeholder="请输入备注信息" value="{{form.remark}}" data-field="remark" bindinput="onFormInput" maxlength="500" />
          </view>
        </view>

        <!-- 底部按钮 -->
        <view class="form-actions">
          <view class="form-btn cancel-btn" bindtap="onCloseForm">
            <text>取消</text>
          </view>
          <view class="form-btn submit-btn" bindtap="onSubmitForm">
            <text>保存</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
