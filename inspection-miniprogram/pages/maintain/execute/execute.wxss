/* pages/maintain/execute/execute.wxss */
.equip-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  padding: 32rpx 28rpx;
  border-radius: 0 0 28rpx 28rpx;
}
.header-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.header-info { flex: 1; }
.header-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.section {
  padding: 20rpx 24rpx 0;
}
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.section-title-count {
  font-size: 24rpx;
  color: #9ca3af;
}

.content-text {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
}

/* 保养项目 */
.exec-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.exec-item:last-child { border-bottom: none; }
.exec-item:active { background: #f9fafb; }
.exec-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 4rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #fff;
  transition: all 0.2s;
}
.exec-check.checked {
  background: #10b981;
  border-color: #10b981;
}
.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.exec-name {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}
.exec-item.done .exec-name {
  color: #6b7280;
}
.exec-status {
  font-size: 26rpx;
  margin-left: 16rpx;
}

/* 照片上传 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #d1d5db;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-add:active {
  background: #f3f4f6;
}
.add-icon {
  font-size: 56rpx;
  color: #d1d5db;
  line-height: 1;
}
.add-text {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* 费用输入 */
.cost-input-wrap {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
}
.cost-prefix {
  font-size: 32rpx;
  font-weight: 600;
  color: #f59e0b;
  margin-right: 12rpx;
}
.cost-input {
  flex: 1;
  font-size: 32rpx;
  color: #1f2937;
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid #e5e7eb;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
