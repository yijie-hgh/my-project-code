/* pages/maintain/detail/detail.wxss */
.detail-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 32rpx 28rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.header-top { margin-bottom: 28rpx; }
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.detail-plan {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
}
.detail-no {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.header-progress {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}
.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}
.progress-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.progress-rate {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.card { margin: 20rpx 24rpx; }
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #6b7280; flex-shrink: 0; }
.info-value { font-size: 28rpx; color: #1f2937; text-align: right; flex: 1; margin-left: 24rpx; }
.info-value-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}
.info-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  margin-left: 8rpx;
}

/* 保养项目 */
.item-list { display: flex; flex-direction: column; }
.check-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.check-item:last-child { border-bottom: none; }
.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  border: 4rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #fff;
}
.check-box.checked {
  background: #10b981;
  border-color: #10b981;
}
.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.check-name {
  flex: 1;
  font-size: 30rpx;
  color: #1f2937;
}
.check-item.done .check-name {
  color: #6b7280;
}
.check-status {
  font-size: 26rpx;
  margin-left: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
