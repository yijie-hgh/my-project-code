/* pages/task/detail/detail.wxss */
.task-header {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  padding: 32rpx 28rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.header-top { margin-bottom: 28rpx; }
.task-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.task-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
}
.task-no {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.header-progress {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}
.progress-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}
.progress-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.progress-rate {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.info-card { margin: 20rpx 24rpx; }
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-row:last-child { border-bottom: none; }
.info-label { font-size: 28rpx; color: #6b7280; }
.info-value { font-size: 28rpx; color: #1f2937; text-align: right; flex: 1; margin-left: 24rpx; }

.card { margin: 20rpx 24rpx; }

.point-list { display: flex; flex-direction: column; }
.point-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.point-item:last-child { border-bottom: none; }
.point-item:active { background: #f9fafb; }
.point-left { display: flex; align-items: center; flex: 1; }
.point-status-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dot-done { background: #d1fae5; color: #10b981; }
.dot-pending { background: #fef3c7; color: #f59e0b; }
.point-info { flex: 1; }
.point-name { font-size: 30rpx; font-weight: 600; color: #1f2937; display: block; margin-bottom: 6rpx; }
.point-meta { display: flex; align-items: center; gap: 16rpx; }
.point-right { display: flex; align-items: center; }
.point-status-text { font-size: 26rpx; }
.point-arrow { font-size: 36rpx; color: #d1d5db; margin-left: 8rpx; }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}
