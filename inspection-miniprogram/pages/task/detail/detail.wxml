<!--pages/task/detail/detail.wxml-->
<view class="page-bg" style="padding-bottom: 160rpx;">
  <empty-state wx:if="{{!loading && !task}}" text="任务不存在" icon="❓"></empty-state>

  <block wx:if="{{task}}">
    <!-- 任务信息头部 -->
    <view class="task-header">
      <view class="header-top">
        <view class="task-title-row">
          <text class="task-name">{{task.taskName}}</text>
          <text class="tag {{task.statusInfo.tag}}">{{task.statusInfo.text}}</text>
        </view>
        <text class="task-no">编号：{{task.taskNo}}</text>
      </view>

      <view class="header-progress">
        <view class="progress-row">
          <text class="progress-label">巡检进度</text>
          <text class="progress-num">{{doneCount}}/{{totalCount}}</text>
        </view>
        <view class="progress-bar" style="height:16rpx;">
          <view class="progress-bar-fill" style="width: {{rate}}%;"></view>
        </view>
        <text class="progress-rate">{{rate}}%</text>
      </view>
    </view>

    <!-- 任务信息 -->
    <view class="card info-card">
      <view class="info-row">
        <text class="info-label">所属项目</text>
        <text class="info-value">{{task.projectName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">巡检人员</text>
        <text class="info-value">{{task.inspectorName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">计划时间</text>
        <text class="info-value">{{task.inspectTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">截止时间</text>
        <text class="info-value {{task.status === '3' ? 'text-danger' : ''}}">{{task.deadline}}</text>
      </view>
      <view wx:if="{{task.finishTime}}" class="info-row">
        <text class="info-label">完成时间</text>
        <text class="info-value text-success">{{task.finishTime}}</text>
      </view>
      <view wx:if="{{task.remark}}" class="info-row">
        <text class="info-label">任务备注</text>
        <text class="info-value">{{task.remark}}</text>
      </view>
    </view>

    <!-- 巡检点列表 -->
    <view class="card">
      <view class="card-title">巡检点（{{totalCount}}）</view>
      <view class="point-list">
        <view wx:for="{{task.pointList}}" wx:key="id" class="point-item {{item.done ? 'done' : ''}}" data-point="{{item}}" bindtap="goExecute">
          <view class="point-left">
            <view class="point-status-dot {{item.done ? 'dot-done' : 'dot-pending'}}">
              <text wx:if="{{item.done}}">✓</text>
              <text wx:else>{{index + 1}}</text>
            </view>
            <view class="point-info">
              <text class="point-name">{{item.pointName}}</text>
              <view class="point-meta">
                <text class="text-sm text-gray">📍 {{item.location}}</text>
                <text wx:if="{{item.done && item.checkInText}}" class="tag tag-info text-sm">{{item.checkInText}}</text>
              </view>
            </view>
          </view>
          <view class="point-right">
            <text class="point-status-text {{item.done ? 'text-success' : 'text-warning'}}">{{item.doneText}}</text>
            <text wx:if="{{!item.done}}" class="point-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-bar">
      <button wx:if="{{allDone && task.status !== '2'}}" class="btn btn-success btn-block" bindtap="onFinishTask">完成巡检任务</button>
      <button wx:elif="{{task.status === '2'}}" class="btn btn-plain btn-block" disabled>任务已完成</button>
      <button wx:else class="btn btn-plain btn-block" disabled>完成所有巡检点后可提交</button>
    </view>
  </block>
</view>
