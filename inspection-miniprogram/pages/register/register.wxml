<!--pages/register/register.wxml-->
<view class="register-page">
  <view class="reg-header">
    <view class="header-bg"></view>
    <view class="logo-area">
      <view class="logo-icon">📝</view>
      <view class="logo-title">注册账号</view>
      <view class="logo-subtitle">设备巡检系统</view>
    </view>
  </view>

  <view class="reg-form">
    <view class="form-title">创建新账号</view>

    <!-- 基本信息 -->
    <view class="section-title">基本信息</view>
    <view class="input-group">
      <view class="input-item {{errors.username ? 'error' : ''}}">
        <text class="input-icon">👤</text>
        <input class="input-field" placeholder="用户名（至少3位）" value="{{form.username}}" data-field="username" bindinput="onInput" maxlength="20"></input>
      </view>
      <text wx:if="{{errors.username}}" class="error-text">{{errors.username}}</text>

      <view class="input-item {{errors.nickName ? 'error' : ''}}">
        <text class="input-icon">📛</text>
        <input class="input-field" placeholder="昵称" value="{{form.nickName}}" data-field="nickName" bindinput="onInput" maxlength="20"></input>
      </view>
      <text wx:if="{{errors.nickName}}" class="error-text">{{errors.nickName}}</text>

      <view class="input-item">
        <text class="input-icon">🔑</text>
        <input class="input-field" placeholder="密码（至少6位）" password value="{{form.password}}" data-field="password" bindinput="onInput" maxlength="20"></input>
      </view>
      <view wx:if="{{passwordStrength.level > 0}}" class="strength-bar">
        <view class="strength-fill" style="background:{{passwordStrength.color}}; width: {{passwordStrength.level * 25}}%;"></view>
        <text class="strength-text" style="color:{{passwordStrength.color}};">{{passwordStrength.text}}</text>
      </view>

      <view class="input-item {{errors.confirmPassword ? 'error' : ''}}">
        <text class="input-icon">🔒</text>
        <input class="input-field" placeholder="确认密码" password value="{{form.confirmPassword}}" data-field="confirmPassword" bindinput="onInput" maxlength="20"></input>
      </view>
      <text wx:if="{{errors.confirmPassword}}" class="error-text">{{errors.confirmPassword}}</text>
    </view>

    <!-- 联系方式 -->
    <view class="section-title">联系方式</view>
    <view class="input-group">
      <view class="input-item {{errors.phone ? 'error' : ''}}">
        <text class="input-icon">📱</text>
        <input class="input-field" placeholder="手机号" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" maxlength="11"></input>
      </view>
      <text wx:if="{{errors.phone}}" class="error-text">{{errors.phone}}</text>

      <!-- 短信验证码 -->
      <view class="input-item sms-item {{errors.smsCode ? 'error' : ''}}">
        <text class="input-icon">🔢</text>
        <input class="input-field" placeholder="短信验证码" type="number" value="{{form.smsCode}}" data-field="smsCode" bindinput="onInput" maxlength="6"></input>
        <view class="sms-btn {{smsCountdown > 0 ? 'disabled' : ''}}" bindtap="{{smsCountdown > 0 ? '' : 'onSendSms'}}">
          <text wx:if="{{smsCountdown > 0}}">{{smsCountdown}}s</text>
          <text wx:elif="{{smsSending}}">发送中...</text>
          <text wx:else>获取验证码</text>
        </view>
      </view>
      <text wx:if="{{errors.smsCode}}" class="error-text">{{errors.smsCode}}</text>

      <view class="input-item {{errors.email ? 'error' : ''}}">
        <text class="input-icon">📧</text>
        <input class="input-field" placeholder="邮箱（选填）" value="{{form.email}}" data-field="email" bindinput="onInput" maxlength="50"></input>
      </view>
      <text wx:if="{{errors.email}}" class="error-text">{{errors.email}}</text>

      <view class="input-item">
        <text class="input-icon">🏢</text>
        <input class="input-field" placeholder="部门名称" value="{{form.deptName}}" data-field="deptName" bindinput="onInput" maxlength="30"></input>
      </view>

      <view class="input-item picker-item">
        <text class="input-icon">🎖️</text>
        <picker mode="selector" range="{{roleOptions}}" range-key="name" value="{{roleIndex}}" bindchange="onRoleChange">
          <view class="picker-value">{{roleOptions[roleIndex].name}} - {{roleOptions[roleIndex].desc}}</view>
        </picker>
      </view>
    </view>

    <!-- 账号绑定（选填） -->
    <view class="bind-section-header" bindtap="toggleBindSection">
      <text class="section-title">第三方账号绑定（选填）</text>
      <text class="toggle-arrow">{{showBindSection ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view wx:if="{{showBindSection}}" class="bind-group">
      <!-- 微信绑定 -->
      <view class="bind-card {{wxBound ? 'bound' : ''}}">
        <view class="bind-left">
          <view class="bind-icon wx-icon-bg">💬</view>
          <view class="bind-info">
            <text class="bind-name">微信</text>
            <text class="bind-status">{{wxBound ? '已绑定' + (wxUserInfo.nickName || '') : '绑定后可用微信快速登录'}}</text>
          </view>
        </view>
        <view wx:if="{{wxBound}}" class="unbind-btn" bindtap="onUnbindWx">解绑</view>
        <view wx:else class="bind-btn" bindtap="onBindWx">绑定</view>
      </view>

      <!-- 飞书绑定 -->
      <view class="bind-card {{feishuBound ? 'bound' : ''}}">
        <view class="bind-left">
          <view class="bind-icon feishu-icon-bg">🔗</view>
          <view class="bind-info">
            <text class="bind-name">飞书</text>
            <text class="bind-status">{{feishuBound ? '已绑定' + (feishuUserInfo.name || '') : '绑定后可用飞书快速登录'}}</text>
          </view>
        </view>
        <view wx:if="{{feishuBound}}" class="unbind-btn" bindtap="onUnbindFeishu">解绑</view>
        <view wx:else class="bind-btn" bindtap="onBindFeishu">绑定</view>
      </view>
    </view>

    <!-- 协议 -->
    <view class="agree-row">
      <checkbox-group bindchange="onAgree">
        <label class="agree-label">
          <checkbox value="1" color="#2563eb" />
          <text>我已阅读并同意</text>
          <text class="protocol-link" bindtap="onProtocol">《用户协议与隐私政策》</text>
        </label>
      </checkbox-group>
    </view>

    <button class="btn btn-primary btn-block reg-btn" bindtap="onRegister" loading="{{loading}}" disabled="{{loading}}">注 册</button>

    <view class="login-link" bindtap="goLogin">已有账号？去登录</view>
  </view>
</view>
