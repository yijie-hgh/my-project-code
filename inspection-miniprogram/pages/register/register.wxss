/* pages/register/register.wxss */
.register-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}
.reg-header {
  position: relative;
  height: 360rpx;
  overflow: hidden;
}
.header-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 100%;
  background: linear-gradient(135deg, #1d4ed8, #2563eb, #3b82f6);
  border-radius: 0 0 60rpx 60rpx;
}
.logo-area {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  padding-top: 100rpx;
}
.logo-icon {
  width: 100rpx; height: 100rpx; border-radius: 28rpx;
  background: rgba(255,255,255,0.2); backdrop-filter: blur(10rpx);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; margin-bottom: 16rpx;
}
.logo-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.logo-subtitle { font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 6rpx; }

.reg-form {
  margin: -50rpx 40rpx 0; background: #fff;
  border-radius: 28rpx; padding: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.08);
}
.form-title { font-size: 36rpx; font-weight: 700; color: #1f2937; margin-bottom: 32rpx; }

.section-title {
  font-size: 28rpx; font-weight: 600; color: #6b7280;
  margin-bottom: 16rpx; margin-top: 8rpx;
}

.input-group { margin-bottom: 24rpx; }
.input-item {
  display: flex; align-items: center;
  background: #f9fafb; border-radius: 16rpx;
  padding: 0 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid #e5e7eb;
}
.input-item.error { border-color: #ef4444; background: #fef2f2; }
.input-icon { font-size: 36rpx; margin-right: 16rpx; }
.input-field { flex: 1; height: 88rpx; font-size: 30rpx; }
.picker-item { height: 88rpx; }
.picker-value { font-size: 28rpx; color: #374151; line-height: 88rpx; }
.error-text { font-size: 22rpx; color: #ef4444; margin: -12rpx 0 16rpx 24rpx; display: block; }

/* 密码强度 */
.strength-bar {
  display: flex; align-items: center; margin: -12rpx 0 16rpx 8rpx;
}
.strength-fill {
  height: 6rpx; border-radius: 3rpx; transition: all 0.3s; margin-right: 12rpx;
  min-width: 60rpx;
}
.strength-text { font-size: 22rpx; }

/* 短信验证码 */
.sms-item { position: relative; }
.sms-btn {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 12rpx;
  margin-left: 16rpx;
}
.sms-btn.disabled { color: #9ca3af; background: #f3f4f6; }

/* 账号绑定区域 */
.bind-section-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx; margin-top: 8rpx;
  padding: 16rpx 0;
}
.bind-section-header .section-title { margin: 0; }
.toggle-arrow { font-size: 24rpx; color: #2563eb; }

.bind-group { margin-bottom: 24rpx; }
.bind-card {
  display: flex; align-items: center; justify-content: space-between;
  background: #f9fafb; border-radius: 16rpx;
  padding: 24rpx; margin-bottom: 16rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.2s;
}
.bind-card.bound { background: #f0fdf4; border-color: #86efac; }
.bind-left { display: flex; align-items: center; flex: 1; }
.bind-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; margin-right: 20rpx;
}
.wx-icon-bg { background: #e8f5e9; }
.feishu-icon-bg { background: #e8f0fe; }
.bind-info { display: flex; flex-direction: column; }
.bind-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.bind-status { font-size: 22rpx; color: #6b7280; margin-top: 4rpx; }
.bind-btn {
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  background: #2563eb;
  border-radius: 24rpx;
}
.unbind-btn {
  padding: 8rpx 28rpx;
  font-size: 26rpx;
  color: #ef4444;
  background: #fef2f2;
  border: 2rpx solid #fca5a5;
  border-radius: 24rpx;
}

/* 协议 */
.agree-row { margin: 24rpx 0 32rpx; }
.agree-label { display: flex; align-items: center; font-size: 24rpx; color: #6b7280; }
.protocol-link { color: #2563eb; }

.reg-btn { height: 90rpx; font-size: 32rpx; letter-spacing: 6rpx; }
.login-link {
  text-align: center; font-size: 26rpx; color: #2563eb; margin-top: 32rpx;
}
