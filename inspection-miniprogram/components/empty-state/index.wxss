/* components/empty-state/index.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.empty-icon {
  font-size: 96rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 30rpx;
  color: #9ca3af;
  margin-top: 24rpx;
}
.empty-sub-text {
  font-size: 24rpx;
  color: #d1d5db;
  margin-top: 12rpx;
}
